# The seed recipe: what tools/seed takes from a nova-tools checkout to make
# nova-sprint's tree. One rule per line, fields separated by TABS; a line that
# starts with # is a comment. The rules, in the order they are applied:
#
#   module   <from module path> <to module path>
#   move     <dir>           every file under dir, tests and testdata included
#   rename   <pkg> <to>      a copied nova-tools package that lands at another path
#   literal  <from> <to>     a string replaced in every moved .go file
#   literal-file <path> <from> <to> a one-time exact edit of one moved Go file
#   doc      <file>          a whole file
#   section  <file> <name>.. the "## <name>" sections of file, under the header
#                            the nova-sprint copy of file already has
#   ratings  <tool>..        docs/ratings/**/<tool>-read.md and <tool>-use.md
#   model    <M>             tla/M.tla, tla/MCM.tla, local modules they
#                            EXTEND/INSTANCE, MCM.tla rows of CASES.tsv and
#                            RUNS.tsv and their .cfg files, README and bench
#   keep     <path>          nova-sprint's own file or dir, taken from -keep
#   gomod                    go.mod from nova-tools with the module renamed and
#                            nova-sprint's tool lines; go.sum from nova-tools
#
# Copied: every nova-tools package the moved code imports (tests included),
# closed over the imports of the copied packages' non-test files. A copied
# package brings its non-test files and //go:embed inputs; embedded Go files
# are import-rewritten too. Renamed packages bring Go files and their embeds.

module	github.com/mas-bandwidth/nova-tools	github.com/mas-bandwidth/nova-sprint

# The move is the sprint-only set of nova-sprint v1.2.3 (split layer L2, nova-tools
# PR 5558): the three commands and the packages no kept nova-tools command imports
# once L2 lands. internal/provbalance is a nova-tools building block: copied here
# until layer L4 imports it from nova-tools.
move	cmd/nova-sprint
move	cmd/nova-card
move	cmd/nova-work
move	internal/sprint
move	internal/sprintdash
move	internal/card
move	internal/cardgen
move	internal/workfile
move	internal/workgh
move	internal/worklang
move	tools/sprintsize

rename	fleet	internal/fleetrules
rename	profiles	internal/profiles
literal	"../../fleet/child-rules.txt"	"../../internal/fleetrules/child-rules.txt"
literal	filepath.Join("..", "..", "fleet", "child-rules.txt")	filepath.Join("..", "..", "internal", "fleetrules", "child-rules.txt")
# Preserve the seat-check probe contract while taking the rest of machinery from tools.
# These fail-closed edits are scoped to the selected tools machinery file only.
literal-file	cmd/nova-sprint/machinery.go	machineVersions func(ctx context.Context, machines []string) (sprint.VersionsM, error)	machineVersions func(ctx context.Context, machines []string) (sprint.VersionsM, error); novaTools func(bin string) sprint.NovaToolsProbe
literal-file	cmd/nova-sprint/machinery.go	st, err := a.store(*c)	if code := a.refuseNovaTools(verb, stderr); code != 0 { return code }; st, err := a.store(*c)
literal-file	internal/sprint/secrets_in_errors_test.go	const sprintSecretLeakAllowlist = `	const sprintSecretLeakAllowlist = sprintNovaToolsLeak + `

doc	docs/SPEC-ISA.md
doc	docs/PROCESSOR.md
doc	docs/COORDINATOR-TOOLS.md
section	docs/CLI.md	nova-sprint	nova-card	nova-work
section	docs/TESTS.md	nova-sprint	nova-card	nova-work
# The sprint and work ratings, the sprint docs and every TLA+ model here are nova-sprint's own from
# v1.2.3 (split layer L5): nova-tools no longer has them, so they are kept, not taken.
keep	docs/SPEC-SPRINT-DASHBOARD.md
keep	docs/SPEC-SPRINT.md
keep	docs/SPEC-WORK-V1.md
keep	docs/SPEC-WORKLANG.md
keep	docs/SPRINT-COORDINATOR-SEAT.md
keep	docs/SPRINT-COORDINATOR.md
keep	docs/ratings/1.1.0
keep	docs/ratings/snapshots
keep	docs/sprint

keep	tla

keep	LICENSE
keep	README.md
keep	Makefile
keep	.github
keep	docs/ASSET-PROVENANCE.md
keep	internal/sprint/tables_lock_test.go
keep	internal/sprint/toolsversion.go
keep	internal/sprint/toolsversion_test.go
keep	cmd/nova-sprint/seat_novatools.go
keep	cmd/nova-sprint/seat_novatools_test.go
keep	tools/seed
gomod
keep	ROADMAP.md
keep	CONTRIBUTING.md
keep	assets
keep	brand
keep	docs/BRAND.md
keep	docs/FIRST-LAP.md
keep	docs/FRIENDS.md
keep	docs/GETTING-STARTED.md
keep	docs/README.md
keep	docs/SPLIT-MOOT-PRS.md
keep	docs/RELEASE-NOTES-v1.0.0.md
keep	internal/sprint/secrets_novatools_test.go
keep	docs/WORKING-WITH-AI-TEAMS.md
keep	docs/ratings/README.md
keep	internal/ci/moot_prs_test.go
keep	CHANGELOG.md
