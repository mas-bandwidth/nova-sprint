// friendrows.schema: the sprint store's friend, beat, hold, lane and seat
// records (S1). Both table forms are used, and the form follows the record.
//
// A FIXED table is a small bounded struct: every bound in it is a bound the
// code enforces today (a ValidID's MaxIDLen, a word list's longest word, a
// count the code caps), and its body stays under the 4096-byte fixed
// advisory (SPEC-TABLES §3.4). The sprint server is the only writer and the
// only reader, and the server is upgraded first. A unit that holds a
// variable table emits no fixed form (form byte 3) for any of its tables, so
// a fixed table here rides the table wire (form byte 1) as an element of the
// variable records that hold it; its class still holds its body bounded and
// gives it the block form (SPEC-TABLES §2.2, §2.7).
//
// A VARIABLE table is a document sized by its content. Where the code states
// no length, the text is *string, at its used size and null when empty. Where
// the code states no count, the list is []T, as long as the data. Where the
// code states a bound, the table declares that bound and no other: a bound is
// never tighter than what the code accepts.
//
// A JSON object the store writes today is a list of entries here, and the
// key stays the store key, not a field, wherever the Go struct has no field
// for it. A time.Time keeps the source JSON representation: RFC3339Nano text in a bounded string. The source decoder validates the timestamp syntax; the table string reader validates its declared length.
// A *T in Go is ?T. A float64 stays a float64: the compiler accepts a numeric
// range on an integer, not on a float64, so a clamp the code applies to a
// percent is named in the comment and is not a declared range.
//
// Where the code states a minimum and no ceiling, the declared max is the
// storage type's own. SPEC §4.6 requires a max beside a min, and a legal wire
// value the storage would truncate is refused at compile time. The code's
// bound is the minimum; the max is the compiler's.
package friendrowswire

// FriendEntry is one friend in the roster (store/friends.go friendEntry), a
// variable table: its row texts carry no length in the code. keyFriends is a
// JSON object keyed by the friend's name, a ValidID of at most MaxIDLen
// (128). The name is that key. It is not a field of the struct.
table FriendEntry
{
    held bool
    // Source time.Time JSON, RFC3339Nano text (string reader checks length).
    at string(35)
    // the coordinator who holds her: a ValidID, MaxIDLen 128 (schema.go).
    by string(128)
    // 0 means the roster has not set a width (json omitempty). checkFriend
    // requires at least 1 when the config row sets one, and states no ceiling.
    // The stored field therefore declares no numeric range.
    width int64
    // her tiers, sorted and comma joined. The store states no length.
    // json "class": class is a reserved word.
    tier_class *string | json = "class"
    // FriendModes: "batch" or "one-shot" (8). Empty is batch.
    mode string(8)
    // comma-separated globs. checkFriend reads each with path.Match and
    // states no length.
    streams *string
    // the same rule as streams.
    kinds *string
    // an absolute path when set (checkFriend). The check states no length.
    config_dir *string
    // FriendPronounSets; the longest is "they/them" (9).
    pronouns string(16)
    // "one-shot" (FriendOneShot, 8) or empty for a live session.
    session string(8)
    // FriendTokenCap: a negative text is not a cap; an explicit 0 is no cap.
    // The code states no ceiling. The max is int64's own (SPEC §4.6).
    token_cap int64 | min = 0, max = 9223372036854775807
    token_cap_set bool
    // comma joined. The store states no length.
    roles *string
    // metered, plan, both or subscription (12). Empty means subscription.
    billing string(16)
    // friend down and hold --reason. The store's setter (friends.go
    // SetFriendHeld) states no length.
    reason *string
    // Source time.Time JSON, RFC3339Nano text (string reader checks length).
    until string(35)
    // json "return": return is a reserved word.
    give_back bool | json = "return"
}

// FriendStatus is the server's derived word for one friend (store/friends.go
// friendStatus), the record keyFriendStatus keeps, a variable table. The
// friend's name is the JSON object's key, not a field. Why is json:"-" and is
// not stored. Evidence is the stored proof word ("nova-hook proven", "held",
// "member beat", or the hook's reason). The friend beat flags --pong, --check
// and --run are accepted by the server and are not fields of any stored
// struct.
table FriendStatus
{
    // FriendStates: "up", "held", "down".
    status string(8)
    // a hook reason or a hold reason, composed by the store with no length.
    reason *string
    // Source time.Time JSON, RFC3339Nano text (string reader checks length).
    until string(35)
    // the proof word or the hook's reason. The store states no length.
    evidence *string
    worker_live bool
    unhooked bool
    // Source time.Time JSON, RFC3339Nano text (string reader checks length).
    at string(35)
}

// LoadSample is one beat's load (presence.go), a fixed table. NextBeat keeps
// the samples in (at - LoadWindow, at) and then appends the current second,
// so a record it writes holds at most 11. LoadWindow is 10s and the stamp is
// truncated to a second. pct is clampLoad onto 0..LoadMax (100). A float64
// declares no range.
fixed table LoadSample
{
    // The original Unix-nanosecond slot stays at its locked wire offset.
    at_ns ?int64 | was = "at", deprecated, json = "at_unix_nanos"
    pct float64
    // Source time.Time JSON, RFC3339Nano text (string reader checks length).
    at_time string(35) | json = "at"
}

// Ticks is one reading of the kernel CPU counters (hostload.Ticks), a fixed
// table.
fixed table Ticks
{
    busy uint64
    total uint64
}

// Holder is one process and how many file descriptors it has open
// (hostload.Holder), a variable table: the command and the user have no
// length in the reader. json "cmd" keeps today's key.
table Holder
{
    pid int64
    command *string | json = "cmd"
    user *string
    open int64
}

// Files is one reading of the machine's open descriptors (hostload.Files), a
// variable table. FilesTop is 10. Warn and alarm are the bounds the reading
// was taken against, not a maximum of the count. top_err has no length in the
// reader.
table Files
{
    // Source time.Time JSON, RFC3339Nano text (string reader checks length).
    at string(35)
    open int64
    max int64
    warn int64
    alarm int64
    // hostload FilesTop: at most 10 holders.
    top [..10]Holder
    // Source time.Time JSON, RFC3339Nano text (string reader checks length).
    top_at string(35)
    top_err *string
}

// Meter is the measuring state the next beat starts from (hostload.State), a
// variable table: it holds Files. A *Ticks is ?Ticks. A *Files is *Files: an
// optional over a variable closure is a compiler follow-on (SPEC-TABLES §2.3,
// §15), and the pointer is null when absent, as Go's nil is. top_pct is
// capped at hostload.MaxPercent (1000) by capped. A float64 declares no
// range.
table Meter
{
    ticks ?Ticks
    // Source time.Time JSON, RFC3339Nano text (string reader checks length).
    top_at string(35)
    top_pct float64
    files *Files
}

// RunWord is one card id or job name in a friend's running list, a variable
// table. runningIDs (serve.go) accepts one joined list of at most 4096 bytes,
// letters, digits and . _ - ~ and the comma, so one word is at most 4096.
table RunWord
{
    text string(4096)
}

// FriendReport is what a friend's beat reports (presence.go FriendReport), a
// variable table. A *int is ?int64 on the 64-bit server. The flag accepts a nonnegative
// platform int with no ceiling, so the max is int64's own (SPEC §4.6).
table FriendReport
{
    // runningIDs bounds the joined list at 4096 bytes and states no count:
    // the list is as long as the data.
    running []RunWord
    // friendBeatFlags --working: wholeAtLeast(0).
    working ?int64 | min = 0, max = 9223372036854775807
    // friendBeatFlags --queue: wholeAtLeast(0).
    queue ?int64 | min = 0, max = 9223372036854775807
    // friendBeatFlags --width: wholeAtLeast(1). No ceiling on the flag.
    // checkFriend states the same minimum and no machine ceiling.
    // The minimum is not a declared range: an optional's absent value is the
    // type's zero, a range that excludes zero is refused, and an optional
    // takes no specified default (SPEC-TABLES §2.3, SPEC §4.6).
    width ?int64
    // a whole number of at least 0. The flag states no ceiling.
    stop_returns ?int64 | min = 0, max = 9223372036854775807
    // her paced width. The struct states no numeric floor. 0 is a reported
    // zero; absent is the ? not set. No ceiling.
    paced ?int64 | min = 0, max = 9223372036854775807
    // Source time.Time JSON, RFC3339Nano text (string reader checks length).
    active string(35)
    // "5h 62% 7d 31%" is the shape the struct names. No length is stated.
    window *string
    // Source time.Time JSON, RFC3339Nano text (string reader checks length).
    until string(35)
    // friendBeatFlags --reason: oneLineText (serve.go), at most 1024.
    reason string(1024)
    // the daemon's version line. The beat states no length.
    build *string
    // Source time.Time JSON, RFC3339Nano text (string reader checks length).
    started string(35)
    // Source time.Time JSON, RFC3339Nano text (string reader checks length).
    present string(35)
}

// LiveWord is one entry of a beat's live set, a fixed table: <card>@<gen> or
// <card>@<gen>:held. validCardID is at most 256, the generation is a decimal
// int, and the held mark is ":held", so 256 + 1 + 19 + 5 = 281.
fixed table LiveWord
{
    text string(281)
}

// FactWord is one gate fact, a fixed table. FactWords (deal.go) requires a
// ValidID, at most MaxIDLen (128), not beginning with "-".
fixed table FactWord
{
    text string(128)
}

// LiveSight is one entry of Beat.LiveSeen, a JSON object keyed by the live
// entry, a fixed table. The pair is an entry. at is the source time.Time JSON text, including its
// UTC offset and nanosecond precision.
fixed table LiveSight
{
    entry string(281)
    // The original Unix-nanosecond slot stays at its locked wire offset.
    at_ns ?int64 | was = "at", deprecated, json = "at_unix_nanos"
    // Source time.Time JSON, RFC3339Nano text (string reader checks length).
    at_time string(35) | json = "at"
}

// Beat is a member's, a friend's or a reader's presence record (presence.go
// Beat), a variable table. The store key is beat:<member>, friend-beat:<friend>
// or reader-beat:<reader>. The name is that key, not a field. load is float64.
// A member beat is clampLoad onto 0..LoadMax (100). A friend's --load is at
// least 0 and has no upper bound. hostload caps a measured percent at
// MaxPercent (1000). A float64 declares no range, so none of those clamps is
// a declared bound. cores has no range. stop_returns is a whole number of at
// least 0 (serve.go workerVerb) and the flag states no ceiling.
table Beat
{
    // Source time.Time JSON, RFC3339Nano text (string reader checks length).
    at string(35)
    // json "load": load is a generated Dart table verb (SPEC-TABLES §11).
    // The clamps are clampLoad onto LoadMax (100), hostload.MaxPercent
    // (1000), and friend beat --load at least 0 with no upper bound. A
    // float64 declares no range.
    load_pct float64 | json = "load"
    cores int64
    // hostload.HowCPU "cpu", HowLoad1 "load1", HowGiven "given".
    how string(8)
    // NextBeat keeps at most 11 samples (LoadSample).
    samples [..11]LoadSample
    meter Meter
    // json "friend": friend is a reserved word. Nil on a machine's beat: the
    // pointer is null, as Go's *FriendReport is; an optional over a variable
    // closure is a compiler follow-on (SPEC-TABLES §2.3, §15).
    report *FriendReport | json = "friend"
    // serve.go: a whole number of at least 0, no ceiling (SPEC §4.6).
    stop_returns int64 | min = 0, max = 9223372036854775807
    // fleet beat --no-room states no length.
    no_room *string
    // live.go maxLiveEntries: ParseLive accepts at most 512 entries.
    live [..512]LiveWord
    live_known bool
    // Source time.Time JSON, RFC3339Nano text (string reader checks length).
    live_since string(35)
    // NextLive keeps each sighting for liveSeenKeep, a time and not a count,
    // so the list is as long as the data.
    live_seen []LiveSight
    draining bool
    // Source time.Time JSON, RFC3339Nano text (string reader checks length).
    draining_since string(35)
    // FactWords states no count.
    facts []FactWord
}

// ReaderHold is the coordinator's hold of a reader (store/readers.go
// readerHold), a variable table. The store key is reader-away:<reader>. The
// name is that key.
table ReaderHold
{
    away bool
    retired bool
    // Source time.Time JSON, RFC3339Nano text (string reader checks length).
    at string(35)
    // a ValidID, MaxIDLen 128.
    by string(128)
    held bool
    // the hold's reason. The store states no length.
    reason *string
    // json "return": return is a reserved word.
    give_back bool | json = "return"
}

// HoldView is one hold in force (hold.go HoldView), the held card where --json
// shows, a variable table. At is the RFC3339 stamp the view already stores,
// not a time.Time.
table HoldView
{
    // HoldMember, HoldFriend and the other hold kinds are short words.
    kind string(16)
    // a ValidID (128) or a friend row "friend." plus a ValidID (135).
    name string(135)
    // The hold view can contain an unbounded friend or reader hold reason.
    reason *string
    // a ValidID, MaxIDLen 128.
    by string(128)
    // stamp() is time.RFC3339, 20 bytes for a UTC second, 32 with a zone.
    at string(32)
    // json "return": return is a reserved word.
    give_back bool | json = "return"
    // the cause as the hold named it (FieldHeldCause). No length is stated.
    cause *string
    // a ValidID, MaxIDLen 128.
    who string(128)
    // HoldReleaseVerb: the release command plus the name. No length is
    // stated.
    release *string
}

// LaneHold is one holder of a lane (lane.go), a fixed table. ValidLaneWho is
// a ValidID (128) or two ValidIDs joined by one slash (128+1+128 = 257).
fixed table LaneHold
{
    who string(257)
    // The original Unix-nanosecond slots stay at their locked wire offsets.
    since_ns ?int64 | was = "since", deprecated, json = "since_unix_nanos"
    seen_ns ?int64 | was = "seen", deprecated, json = "seen_unix_nanos"
    claimed bool
    // Source time.Time JSON, RFC3339Nano text (string reader checks length).
    since_time string(35) | json = "since"
    // Source time.Time JSON, RFC3339Nano text (string reader checks length).
    seen_time string(35) | json = "seen"
}

// LaneWait is one waiter (lane.go), a fixed table. The same who as LaneHold.
fixed table LaneWait
{
    who string(257)
    // The original Unix-nanosecond slots stay at their locked wire offsets.
    since_ns ?int64 | was = "since", deprecated, json = "since_unix_nanos"
    seen_ns ?int64 | was = "seen", deprecated, json = "seen_unix_nanos"
    // Source time.Time JSON, RFC3339Nano text (string reader checks length).
    since_time string(35) | json = "since"
    // Source time.Time JSON, RFC3339Nano text (string reader checks length).
    seen_time string(35) | json = "seen"
}

// Lane is one machine's lanes of one kind (lane.go): holders and queue, oldest
// first, a variable table. The store keeps Lanes, a JSON object keyed by
// machine, under lanes:<kind> (store/lane.go laneKey). The machine and the
// kind are that key. They are not fields of Lane. The code states no count of
// holders or waiters, and LaneWidth is at least 1 with no ceiling, so each
// list is as long as the data.
table Lane
{
    holders []LaneHold
    queue []LaneWait
}

// SeatChange is one change of the coordinator's seat (seat.go), a variable
// table. The store key is "seat". NotSeat requires a ValidID holder and a
// non-empty reason, and states no length for the reason.
table SeatChange
{
    // a ValidID, MaxIDLen 128.
    holder string(128)
    generation uint64
    // a ValidID, MaxIDLen 128.
    from string(128)
    // Source time.Time JSON, RFC3339Nano text (string reader checks length).
    at string(35)
    // a ValidID, MaxIDLen 128.
    by string(128)
    taken bool
    // a ValidID, MaxIDLen 128. json keeps today's key.
    approved_by string(128)
    reason *string
}

// ServerRecord is the server's heartbeat (store/seat.go), the store key
// "server", a variable table. Version, commit and host have no length in
// SetServer. PID is Go's platform int.
table ServerRecord
{
    // a ValidID, MaxIDLen 128.
    actor string(128)
    // Source time.Time JSON, RFC3339Nano text (string reader checks length).
    at string(35)
    version *string
    commit *string
    // Source time.Time JSON, RFC3339Nano text (string reader checks length).
    started string(35)
    land bool
    pid int64
    host *string
}

// Login is the seat login record (cmd/nova-sprint/storelogin.go storeLogin),
// a variable table. It names where the password lives. It holds no secret
// value. recordedLogin refuses an empty redis or user and states no length
// for any field. json "as" and "secret": as is a reserved word, and
// secret_name says the field is the nova-secrets name, never a password.
table Login
{
    redis *string
    user *string
    store *string
    seat_as *string | json = "as"
    key *string
    sops *string
    secret_name *string | json = "secret"
}
