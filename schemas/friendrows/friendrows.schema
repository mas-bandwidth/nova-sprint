// friendrows.schema: the sprint store's friend, beat, hold, lane and seat
// records (S1). Both table forms are used, and the form follows the record.
//
// The form ruling (the coordinator, 2026-10-17): a bound is declared only where
// every code path that writes the value (the verbs, the store's direct
// setters, the restore and migration paths) and every path that reads it
// enforces it. Where one path states no check, the field is open: text is
// *string at its used size and null when empty, a list is []T as long as the
// data, and an integer declares no range. A table that holds an open field is
// a VARIABLE table, a document sized by its content. The bound table in the
// pull request cites the file and line of every path for each bound that
// stays.
//
// A FIXED table is a small bounded struct whose every field is bounded by its
// Go type alone and whose body stays under the 4096-byte fixed advisory
// (SPEC-TABLES §3.4). Ticks is the one: two uint64 counters. A unit that holds
// a variable table emits no fixed form (form byte 3) for any of its tables, so
// a fixed table here rides the table wire (form byte 1) as an element of the
// variable records that hold it; its class still holds its body bounded and
// gives it the block form (SPEC-TABLES §2.2, §2.7).
//
// A JSON object the store writes today is a list of entries here, and the
// key stays the store key, not a field, wherever the Go struct has no field
// for it. A time.Time keeps the source JSON representation: RFC3339Nano text,
// open text here, because time.Time accepts a longer RFC3339 value than any
// bound would. The source decoder validates the timestamp syntax. A *T in Go
// is ?T. A float64 stays a float64: the compiler accepts a numeric range on an
// integer, not on a float64, so a clamp the code applies to a percent is named
// in the comment and is not a declared range.
package friendrowswire

// FriendEntry is one friend in the roster (store/friends.go friendEntry), a
// variable table. keyFriends is a JSON object keyed by the friend's name. The
// name is that key. It is not a field of the struct. SetFriendHeld and
// SyncFriends write every text below with no length check, and the roster is
// read by json.Unmarshal with none, so no field of it is bounded.
table FriendEntry
{
    held bool
    // Source time.Time JSON, RFC3339Nano text.
    at *string
    // the coordinator who holds her; SetFriendHeld stores it unchecked.
    by *string
    // 0 means the roster has not set a width (json omitempty). checkFriend
    // requires at least 1 when the config row sets one, and the roster reads
    // and SyncFriends writes none, so no range is declared.
    width int64
    // her tiers, sorted and comma joined. json "class": class is a reserved
    // word.
    tier_class *string | json = "class"
    // "batch" or "one-shot"; empty is batch. SyncFriends stores it unchecked.
    mode *string
    // comma-separated globs.
    streams *string
    kinds *string
    // an absolute path when set.
    config_dir *string
    // the row's pronouns, stored unchecked by SyncFriends.
    pronouns *string
    // "one-shot" or empty for a live session, stored unchecked.
    session *string
    // FriendTokenCap: a negative text is not a cap; an explicit 0 is no cap.
    // The roster states no floor and no ceiling.
    token_cap int64
    token_cap_set bool
    // comma joined.
    roles *string
    // metered, plan, both or subscription; empty means subscription. Stored
    // unchecked by SyncFriends.
    billing *string
    // friend down and hold --reason.
    reason *string
    // Source time.Time JSON, RFC3339Nano text.
    until *string
    // json "return": return is a reserved word.
    give_back bool | json = "return"
}

// FriendStatus is the server's derived word for one friend (store/friends.go
// friendStatus), the record keyFriendStatus keeps, a variable table. The
// friend's name is the JSON object's key, not a field. Why is json:"-" and is
// not stored. Evidence is the stored proof word ("nova-hook proven", "held",
// "member beat", or the hook's reason). The friend beat flags --pong, --check
// and --run are accepted by the server and are not fields of any stored
// struct.
table FriendStatus
{
    // FriendStates: "up", "held", "down". The writer (PublishFriendStatus, from
    // deriveFriendStatus) sets it from PresenceStatus or FriendHookStatus, which
    // return only those words, but the reader (FriendRows) shows any word
    // outside FriendStates as down and accepts any length, so status is open
    // text.
    status *string
    // a hook reason or a hold reason, composed by the store with no length.
    reason *string
    // Source time.Time JSON, RFC3339Nano text.
    until *string
    // the proof word or the hook's reason.
    evidence *string
    worker_live bool
    unhooked bool
    // Source time.Time JSON, RFC3339Nano text.
    at *string
}

// Stranger is one unknown machine that beats (presence.go stranger), a variable
// table. The strangers record (keyStrangers) is a JSON object keyed by the
// machine's name, and the name is that key, not a field; the roster reads each
// entry alike (presenceRowMap). A stranger's seen is the source time.Time JSON
// text and told is whether the coordinator was told of it; noteStranger sets
// both with no length check, so no field of it is bounded.
table Stranger
{
    // Source time.Time JSON, RFC3339Nano text.
    seen *string
    told bool
}

// LoadSample is one beat's load (presence.go), a variable table. NextBeat
// keeps the samples in (at - LoadWindow, at) and appends the current second,
// with no count in the code. pct is clampLoad onto 0..LoadMax (100) for a
// member's beat; a float64 declares no range.
table LoadSample
{
    pct float64
    // Source time.Time JSON, RFC3339Nano text.
    at *string
}

// Ticks is one reading of the kernel CPU counters (hostload.Ticks), a fixed
// table: two uint64 fields, bounded by their type and by no declared bound.
fixed table Ticks
{
    busy uint64
    total uint64
}

// Holder is one process and how many file descriptors it has open
// (hostload.Holder), a variable table: the command and the user have no
// length in the reader. json "cmd" keeps today's key.
table Holder
{
    pid int64
    command *string | json = "cmd"
    user *string
    open int64
}

// Files is one reading of the machine's open descriptors (hostload.Files), a
// variable table. Warn and alarm are the bounds the reading was taken
// against, not a maximum of the count. The reader keeps the top holders at
// hostload FilesTop (10), and the stored record is read back by json.Unmarshal
// with no count check, so the list is as long as the data.
table Files
{
    // Source time.Time JSON, RFC3339Nano text.
    at *string
    open int64
    max int64
    warn int64
    alarm int64
    top []Holder
    // Source time.Time JSON, RFC3339Nano text.
    top_at *string
    top_err *string
}

// Meter is the measuring state the next beat starts from (hostload.State), a
// variable table: it holds Files. A *Ticks is ?Ticks. A *Files is *Files: an
// optional over a variable closure is a compiler follow-on (SPEC-TABLES §2.3,
// §15), and the pointer is null when absent, as Go's nil is. top_pct is
// capped at hostload.MaxPercent (1000) by capped. A float64 declares no
// range.
table Meter
{
    ticks ?Ticks
    // Source time.Time JSON, RFC3339Nano text.
    top_at *string
    top_pct float64
    files *Files
}

// RunWord is one card id or job name in a friend's running list, a variable
// table. runningIDs (serve.go) bounds the joined list the verb takes, but
// the direct verb sets Running from sprint.Split, which has no length check
// (cmd/nova-sprint/friends.go, internal/sprint/state.go), so the word is open
// text.
table RunWord
{
    text *string
}

// FriendReport is what a friend's beat reports (presence.go FriendReport), a
// variable table. A *int is ?int64 on the 64-bit server. The flags check a
// floor, but Store.FriendBeatReport takes the struct whole and no store path
// checks it, so no range is declared on any integer.
table FriendReport
{
    // as long as the data.
    running []RunWord
    working ?int64
    queue ?int64
    width ?int64
    stop_returns ?int64
    // her paced width. 0 is a reported zero; absent is the ? not set.
    paced ?int64
    // Source time.Time JSON, RFC3339Nano text.
    active *string
    // "5h 62% 7d 31%" is the shape the struct names. No length is stated.
    window *string
    // Source time.Time JSON, RFC3339Nano text.
    until *string
    // friend beat --reason: oneline.Escape of the flag, with no length check
    // (cmd/nova-sprint/friends.go).
    reason *string
    // the daemon's version line. The beat states no length.
    build *string
    // Source time.Time JSON, RFC3339Nano text.
    started *string
    // Source time.Time JSON, RFC3339Nano text.
    present *string
}

// LiveWord is one entry of a beat's live set: <card>@<gen> or
// <card>@<gen>:held, a variable table. ParseLive bounds the verb's text, but
// Store.BeatLive and FriendBeatLive take the []string whole (NextLive clones
// it unfiltered) and the stored beat is read back by json.Unmarshal, so the
// word is open text.
table LiveWord
{
    text *string
}

// FactWord is one gate fact, a variable table. FactWords (deal.go) requires a
// ValidID for the verb's text, but Store.BeatFacts takes the []string whole,
// so the word is open text.
table FactWord
{
    text *string
}

// LiveSight is one entry of Beat.LiveSeen, a JSON object keyed by the live
// entry. The pair is an entry. at is the source time.Time JSON text,
// including its UTC offset and nanosecond precision.
table LiveSight
{
    entry *string
    // Source time.Time JSON, RFC3339Nano text.
    at *string
}

// Beat is a member's, a friend's or a reader's presence record (presence.go
// Beat), a variable table. The store key is beat:<member>, friend-beat:<friend>
// or reader-beat:<reader>. The name is that key, not a field. load is float64.
// A member beat is clampLoad onto 0..LoadMax (100). A friend's --load is at
// least 0 and has no upper bound. hostload caps a measured percent at
// MaxPercent (1000). A float64 declares no range, so none of those clamps is
// a declared bound. Store.BeatFacts sets StopReturns, Live and Facts from its
// arguments unchecked, and the beat is read back by json.Unmarshal, so no
// field of it is bounded.
table Beat
{
    // Source time.Time JSON, RFC3339Nano text.
    at *string
    // json "load": load is a generated Dart table verb (SPEC-TABLES §11).
    load_pct float64 | json = "load"
    cores int64
    // hostload.HowCPU "cpu", HowLoad1 "load1", HowGiven "given".
    how *string
    // NextBeat keeps every sample inside the load window and appends one,
    // with no count (internal/sprint/presence.go).
    samples []LoadSample
    meter Meter
    // json "friend": friend is a reserved word. Nil on a machine's beat: the
    // pointer is null, as Go's *FriendReport is; an optional over a variable
    // closure is a compiler follow-on (SPEC-TABLES §2.3, §15).
    report *FriendReport | json = "friend"
    stop_returns int64
    // fleet beat --no-room states no length.
    no_room *string
    live []LiveWord
    live_known bool
    // Source time.Time JSON, RFC3339Nano text.
    live_since *string
    // NextLive keeps each sighting for liveSeenKeep, a time and not a count,
    // so the list is as long as the data.
    live_seen []LiveSight
    draining bool
    // Source time.Time JSON, RFC3339Nano text.
    draining_since *string
    // as long as the data.
    facts []FactWord
}

// ReaderHold is the coordinator's hold of a reader (store/readers.go
// readerHold), a variable table. The store key is reader-away:<reader>. The
// name is that key.
table ReaderHold
{
    away bool
    retired bool
    // Source time.Time JSON, RFC3339Nano text.
    at *string
    // the holder, stored as given by setReaderHold.
    by *string
    held bool
    // the hold's reason. The store states no length.
    reason *string
    // json "return": return is a reserved word.
    give_back bool | json = "return"
}

// HoldView is one hold in force (hold.go HoldView), the held card where --json
// shows, a variable table. At is the RFC3339 stamp the view already stores,
// not a time.Time. A member's or a stream's hold reads its by and at from a
// control card field, unchecked, so no field of it is bounded.
table HoldView
{
    // HoldMember, HoldFriend and the other hold kinds are short words.
    kind *string
    name *string
    reason *string
    by *string
    at *string
    // json "return": return is a reserved word.
    give_back bool | json = "return"
    // the cause as the hold named it (FieldHeldCause).
    cause *string
    who *string
    // HoldReleaseVerb: the release command plus the name.
    release *string
}

// LaneHold is one holder of a lane (lane.go), a variable table. The verb
// checks ValidLaneWho, but the stored record is read back by json.Unmarshal
// with no check of the word, so who is open text.
table LaneHold
{
    who *string
    claimed bool
    // Source time.Time JSON, RFC3339Nano text.
    since *string
    // Source time.Time JSON, RFC3339Nano text.
    seen *string
}

// LaneWait is one waiter (lane.go), a variable table. The same who as
// LaneHold.
table LaneWait
{
    who *string
    // Source time.Time JSON, RFC3339Nano text.
    since *string
    // Source time.Time JSON, RFC3339Nano text.
    seen *string
}

// Lane is one machine's lanes of one kind (lane.go): holders and queue, oldest
// first, a variable table. The store keeps Lanes, a JSON object keyed by
// machine, under lanes:<kind> (store/lane.go laneKey). The machine and the
// kind are that key. They are not fields of Lane. The code states no count of
// holders or waiters, and LaneWidth is at least 1 with no ceiling, so each
// list is as long as the data.
table Lane
{
    holders []LaneHold
    queue []LaneWait
}

// SeatChange is one change of the coordinator's seat (seat.go), a variable
// table. The store key is "seat". NotSeat requires a ValidID holder and a
// non-empty reason, and states no length for the reason; the record is read
// back unchecked, so no text of it is bounded.
table SeatChange
{
    holder *string
    generation uint64
    from *string
    // Source time.Time JSON, RFC3339Nano text.
    at *string
    by *string
    taken bool
    // json keeps today's key.
    approved_by *string
    reason *string
}

// ServerRecord is the server's heartbeat (store/seat.go), the store key
// "server", a variable table. Version, commit and host have no length in
// SetServer. PID is Go's platform int.
table ServerRecord
{
    actor *string
    // Source time.Time JSON, RFC3339Nano text.
    at *string
    version *string
    commit *string
    // Source time.Time JSON, RFC3339Nano text.
    started *string
    land bool
    pid int64
    host *string
}

// Login is the seat login record (cmd/nova-sprint/storelogin.go storeLogin),
// a variable table. It names where the password lives. It holds no secret
// value. recordedLogin refuses an empty redis or user and states no length
// for any field. json "as" and "secret": as is a reserved word, and
// secret_name says the field is the nova-secrets name, never a password.
table Login
{
    redis *string
    user *string
    store *string
    seat_as *string | json = "as"
    key *string
    sops *string
    secret_name *string | json = "secret"
}
