// verbs.schema: the --json output of the nova-sprint verbs that print their
// own object (cmd/nova-sprint: install.go, seat.go, friendsync_install.go,
// fleetsync.go, watchwake.go, goal.go, snapshot.go, shadow.go,
// settings_verb.go, serve.go, run.go, remind.go, log.go, streams.go,
// storelogin.go, stats.go, seatinstall.go, sayok.go) as VARIABLE tables. The
// worker answers (Aspect 11) and where are not here. Its Go is generated into
// pkg/verbjsonwire (go generate ./pkg/verbjsonwire).
//
// A VARIABLE table (the owner's S1): a program of another version reads this
// output, so an older reader meets a newer writer's fields, skips them and
// counts them. Read by pkg/schemaread (S2), which accepts the binary wire,
// padded standard base64 of it, and the JSON text form, and refuses every
// clamp and every damaged image by name.
//
// THE JSON TEXT FORM keeps today's keys: a field spells the key the Go struct
// or the map literal spells (the json attribute where the schema name cannot
// be the key). Today's value shapes are kept:
//   - a Go []string is a text list (docs/USAGE.md, "Text lists and array-root
//     tables"): a bare []string where no code bounds an element, and
//     []string(N) where the code enforces N bytes (sprint.MaxIDLen 128 for an
//     id, a card id at most four dot-joined ids 515);
//   - a Go time.Time is the string it marshals to (RFC 3339 with nanoseconds,
//     at most 35 bytes; 40 here), and *time.Time is an optional of it;
//   - a field today's Go omits when empty (omitempty) is optional (?T) when it
//     is a bool or a number, so the text form omits it too (docs/SPEC-TABLES.md
//     section 2.3). A pointer (*T), a text (*string, string(N)), an unbounded
//     list ([]T) and a map have no optional spelling at this pin (?*T and ?[]T
//     are refused, sections 2.3 and 2.13.1; ?string(N) is a named follow-on,
//     section 15): absent, the text form writes null, "", [] or {} where
//     today's Go writes nothing (section 16.2);
//   - a root that is a Go map literal (sayOK's facts, the install verbs, goal
//     drop, snapshot --restore-drill, settings, seat, coordinator) lists its
//     fields in key order, the order encoding/json writes a map's keys;
//   - an optional object that holds an unbounded text is a pointer (*T), the
//     Go *T it is today (section 2.3: ? on a variable-length closure is a
//     named follow-on).
//
// The root table of every --json verb is named beside its source file: SayOK
// (sayok.go), UnitRemoved and UnitInstalled and UnitsCheck (install.go,
// friendsync_install.go), SeatInstall (seatinstall.go), SeatCoordinator and
// Handover and SeatCheck and SeatRepaired and SeatRecord and StoreLogin
// (seat.go, storelogin.go), SyncReport (fleetsync.go), WakeState
// (watchwake.go), WakeAnswer (log.go, serve.go), GoalShow and GoalSet and
// GoalDrop (goal.go), SnapshotDrill and SnapshotTaken (snapshot.go), ShadowOut
// and ShadowRecord (shadow.go), SettingValue and SettingsOk
// (settings_verb.go), MachineOut (run.go), RemindView and RemindList
// (remind.go), LogOut (log.go), StreamsView (streams.go), PassStats
// (stats.go). The worker answers (Aspect 11) and where are not here.
//
// The bounds are the code's where it holds one: sprint.MaxIDLen (128) for an
// id, a card id of at most four dot-joined ids (515), a friend row of
// "friend." plus an id (135), store.MaxCardTextBytes (64 KiB) for the words a
// change carries, sprint.MaxCause (300) for a cause; a word of a closed set the
// code writes (a state, a status, a verb, a kind, a table name), a SHA-256 in
// hex (64) and a Redis stream id (41) are bounded by their set or format. A
// text the code bounds nowhere (a path, a unit file, a server or Redis address,
// a user, an error, a reason, a summary, an inbox group id) is unbounded
// text, *string (docs/SPEC-TABLES.md sections 2.5 and 2.13.1: no cap is
// invented), and a count the code bounds nowhere is unbounded ([]T): a list is
// never clamped, and the reader refuses what a declared bound would cut.
package verbjsonwire

// ---- sayok.go: the envelope of a verb's success -----------------------------

// SayOK is sayOK's object when a verb has no facts beside the envelope: the
// verb's name, its status and its exit code. Every verb's own facts ride
// beside these keys in the verb's own table.
table SayOK
{
    exit   int64
    status string(16)
    verb   string(32)
}

// ---- install.go, friendsync_install.go, seatinstall.go: the unit verbs ----------

// UnitRemoved is the uninstall verbs' object (install.go uninstallUnit,
// friendsync_install.go): a dry run prints path, present and dry_run; a
// removal prints path and removed.
table UnitRemoved
{
    dry_run ?bool
    path    *string
    present ?bool
    removed ?bool
}

// UnitInstalled is the install verbs' object (install.go, friendsync_install.go):
// a dry run prints path, the unit text, args and dry_run; an install prints
// path, written, loaded and args. The unit text is a launchd plist or a
// systemd unit, which no code bounds (unbounded text).
table UnitInstalled
{
    args    []string
    dry_run ?bool
    loaded  ?bool
    path    *string
    unit    *string
    written ?bool
}

// UnitState is units.UnitState: one unit kind a running sprint needs.
table UnitState
{
    kind    string(64)
    owed    *string
    path    *string
    state   string(16)
    why     *string
    install *string
}

// UnitsCheck is units --check's object: the directory looked in, each unit's
// state and whether every unit is installed.
table UnitsCheck
{
    dir   *string
    ok    bool
    units []UnitState
}

// SeatInstall is seat install's object (seatinstall.go): the server recorded,
// whether it was a dry run, and the lines it printed.
table SeatInstall
{
    dry_run bool
    seat    []string
    server  *string
}

// ---- seat.go: the seat ------------------------------------------------------------

// SeatChange is sprint.SeatChange: the last change of the seat.
table SeatChange
{
    holder       string(135)
    generation   uint64
    from         string(135)
    at           string(40)
    by           string(135)
    taken        ?bool
    approved_by  string(135)
    reason       *string
}

// SeatView is seatView: the holder, the seat's generation and the last change
// of the seat; since (empty when absent) and last are absent while the seat has
// not moved.
table SeatView
{
    holder     string(135)
    generation uint64
    since      string(40)
    last       *SeatChange
}

// ServerView is serverView: the actor the server runs as and, when it is not
// the seat's holder, the line of its unit to change.
table ServerView
{
    actor  string(135)
    change *string
}

// StreamCounts is streamCounts: a stream and its cards in each state. The key
// is a state word (sprint.States: waiting, ready, working, review, merging,
// landed), at most 16 bytes.
table StreamCounts
{
    stream string(128)
    counts map[string(16)]int64
}

// SentinelView is sentinelView: a sentinel, whether it was reached and the
// cards waiting behind it.
table SentinelView
{
    id      string(515)
    stream  string(128)
    reached bool
    behind  []string(515)
}

// InboxAnswer is inboxAnswer: one decision and the command lines that make it.
table InboxAnswer
{
    decision *string
    commands []string
}

// InboxJudgment is inboxJudgment: one open judgment of the inbox; due is
// empty when the judgment has no due time.
table InboxJudgment
{
    id        *string
    alias     string(16)
    kind      string(32)
    type_     string(64) | json = "type"
    what      *string
    stream    string(128)
    size      int64
    cards     []string(515)
    notes     []string
    marked    bool
    overdue   bool
    waited    string(64)
    due       string(40)
    answers   []InboxAnswer
    decisions []string
}

// MemberView is memberView: a member held or down, and by whom.
table MemberView
{
    member string(128)
    status string(16)
    by     string(135)
}

// RoutesView is routesView: how many routes are enabled, and which are not.
table RoutesView
{
    enabled  int64
    disabled []string(128)
}

// DecisionView is decisionView: one of the coordinator's last decisions.
table DecisionView
{
    at     string(40)
    verb   string(32)
    what   *string
    by     string(135)
    reason *string
}

// Handover is handoverView: what the next seat needs. The decisions are the
// last handoverDecisions (10) of the log.
table Handover
{
    at        string(40)
    seat      SeatView
    owner     string(135)
    server    *ServerView
    machine   *string
    summary   *string
    streams   []StreamCounts
    sentinels []SentinelView
    judgments []InboxJudgment
    members   []MemberView
    routes    RoutesView
    decisions [..10]DecisionView
    rules     []string
    first     []string
}

// SeatCoordinator is coordinator's object (seat.go cmdCoordinator): the new
// holder, the previous one, who moved it and the handover that follows.
table SeatCoordinator
{
    approved_by string(135)
    by          string(135)
    from        string(135)
    handover    Handover
    holder      string(135)
    op          string(128)
    taken       bool
}

// SeatCheck is seat's object (seat.go cmdSeat): sayOK's verb, status and exit
// beside the holder, the epoch, the generation, the seat record's holder and
// the server; a drifting seat names the drift and exits 1 (it prints no verb).
table SeatCheck
{
    drift      *string
    epoch      uint64
    exit       int64
    generation uint64
    holder     string(135)
    record     string(135)
    server     *string
    status     string(16)
    verb       string(32)
}

// SeatRepaired is seat --repair's object (seat.go seatRepair).
table SeatRepaired
{
    by     string(135)
    drift  *string
    exit   int64
    holder string(135)
    op     string(128)
    status string(16)
    verb   string(32)
    was    string(135)
}

// SeatRecord is seat.json (seat.go seatRecord): the server and the nova-config
// seat the seat install learned.
table SeatRecord
{
    server      *string
    config_seat string(128)
}

// StoreLogin is login.json (storelogin.go storeLogin): where the store is and
// where its password is kept; it holds no secret.
table StoreLogin
{
    redis  *string
    user   *string
    store  *string
    as_    string(128) | json = "as"
    key    *string
    sops   *string
    secret *string
}

// ---- fleetsync.go -------------------------------------------------------------------

// SyncDrift is syncDrift: one way the fleet table differs from the inventory.
table SyncDrift
{
    member string(128)
    kind   string(32)
    from   ?int64
    to     ?int64
}

// SyncReport is syncReport: fleet sync's one shape whether the verb checked,
// had nothing to write, or wrote.
table SyncReport
{
    verb    string(32)
    check   bool
    members int64
    drift   []SyncDrift
    held    []string(128)
    holding []string
    waiting []string
    moved   []string
    refused []string
    error   *string
}

// ---- watchwake.go -------------------------------------------------------------------

// WakeState is the watch-wake state file (watchwake.go wakeState): the cursor
// into the bus, the judgments and stop seen, the friends down with their
// counts and the friends already told, with the last wake of each kind.
table WakeState
{
    seeded    bool
    bus       string(41)
    judgments []string
    stop      *string
    down      map[string(128)]int64
    told      []string(128)
    last      map[string(128)]string(40)
}

// WakeAnswer is log --wait-tick's object (log.go, serve.go): the log cursor (a
// Redis stream id, "<ms>-<seq>", 20 + 1 + 20 = 41) and whether a tick woke it.
table WakeAnswer
{
    cursor string(41)
    woke   bool
}

// ---- goal.go ---------------------------------------------------------------------------

// GoalView is goalView: a person's goal and where it stands. text is the
// goal's text, at most store.MaxCardTextBytes (64 KiB).
table GoalView
{
    name  string(128)
    route string(128)
    last  string(40)
    count int64
    state string(16)
    error *string
    text  string(65536)
}

// GoalShow is goal show's object (cmd/nova-sprint/goal.go:188-190): the views
// it prints as a top-level JSON array, which the array root writes
// (docs/SPEC-TABLES.md section 16.10).
table GoalShow | json = "array"
{
    goals []GoalView
}

// GoalSet is goal set's object: a GoalView with new, whether the goal was
// created.
table GoalSet
{
    name    string(128)
    route   string(128)
    last    string(40)
    count   int64
    state   string(16)
    error   *string
    text    string(65536)
    created bool | json = "new"
}

// GoalDrop is goal drop's object.
table GoalDrop
{
    dropped bool
    name    string(128)
}

// ---- snapshot.go -------------------------------------------------------------------------

// SnapshotCounts is store.SnapshotCounts.
table SnapshotCounts
{
    keys  int64
    cards int64
}

// SnapshotDrill is snapshot --restore-drill's object. sha256 is 64 hex bytes;
// restore is store.RestoreIntegrity or store.RestoreSemantic.
table SnapshotDrill
{
    counts  SnapshotCounts
    file    *string
    restore string(16)
    sha256  string(64)
}

// SnapshotTaken is store.SnapshotTaken: snapshot's object.
table SnapshotTaken
{
    file    *string
    sha256  string(64)
    bytes_  int64 | json = "bytes"
    counts  SnapshotCounts
    restore string(16)
    pruned  []string
}

// ---- shadow.go ---------------------------------------------------------------------------

// ShadowPart is store.ShadowPart: one part of a tick with something to do.
table ShadowPart
{
    table_ string(32) | json = "table"
    name   string(64)
    size   int64
    due    ?int64
}

// ShadowPlan is store.ShadowPlan: what a shadow tick planned.
table ShadowPlan
{
    epoch   uint64
    state   string(16)
    parts   []ShadowPart
    size    int64
    took_ns int64
    reads   []string
}

// ShadowOut is tick --shadow's object: the plan, or the error.
table ShadowOut
{
    shadow ?ShadowPlan
    error  *string
}

// ShadowRecord is <target>.shadow.json (shadow.go shadowRecord): the
// candidate's shadow tick beside the switch record.
table ShadowRecord
{
    binary  *string
    at      string(40)
    wall_ns int64
    plan    ShadowPlan
}

// ---- settings_verb.go --------------------------------------------------------------------

// SettingValue is sprint.SettingValue: one setting, one object a line.
table SettingValue
{
    flag     string(64)
    prop     string(64)
    value    *string
    dflt     *string | json = "default"
    set      bool
    accessor string(256)
}

// SettingsOk is the closing object of settings: how many settings, how many
// set, and the epoch.
table SettingsOk
{
    count int64
    epoch uint64
    set   int64
}

// ---- run.go: start, stop, tick -------------------------------------------------------------

// Refusal is sprint.Refusal: a key (a card or row id) and why it was refused.
table Refusal
{
    id  string(515)
    why *string
}

// DrainedResult is a store.Result a step drained before it planned (the
// drained list of a Result holds results that drain nothing themselves).
table DrainedResult
{
    verb     string(32)
    op       string(128)
    moved    []string
    refused  []Refusal
    notes    int64
    raised   []string
    said     []string
    attempts int64
    replay   ?bool
    repaired []string
    pending  string(128)
    skipped  []string
    args     *string
    lost     ?bool
    tables   map[string(32)]int64
}

// PartResult is store.PartResult: a tick part's name and the Result it wrote,
// whose keys the object carries beside the name.
table PartResult
{
    name     string(64)
    verb     string(32)
    op       string(128)
    moved    []string
    refused  []Refusal
    notes    int64
    raised   []string
    said     []string
    attempts int64
    replay   ?bool
    repaired []string
    pending  string(128)
    skipped  []string
    args     *string
    lost     ?bool
    tables   map[string(32)]int64
    drained  []DrainedResult
}

// RepairResult is store.RepairResult: a pending operation a tick finished.
table RepairResult
{
    op      string(128)
    verb    string(32)
    done    string(32)
    detail  *string
    skipped []string
}

// LaneQuiet is sprint.LaneQuiet: a judgment the lane check kept from rising.
table LaneQuiet
{
    type_   string(64) | json = "type"
    subject *string
    why     *string
    friend_name string(135) | json = "friend"
    run     *string
}

// TableRows is store.TableRows: a table of a tick and the rows its parts
// changed in it.
table TableRows
{
    table_ string(32) | json = "table"
    rows   []string
}

// ArchiveResult is store.ArchiveResult: the streams a tick archived and drew.
table ArchiveResult
{
    archived []string(128)
    shown    []string(128)
}

// PartTime is store.PartTime: one part of a tick and the time its step took.
table PartTime
{
    table_   string(32) | json = "table"
    name     string(64)
    took_ns  int64
    trips    int64
    reads    int64
    rows     int64
    stale    ?int64
    mismatch ?int64
    asked    ?int64
    refused  ?int64
    lost     ?int64
}

// TickResult is store.TickResult: what a tick did.
table TickResult
{
    state        string(16)
    tick_end     ?int64
    idle         ?bool
    repaired     []RepairResult
    parts        []PartResult
    stale        *string
    halted       *string
    due          ?int64
    quiet        []LaneQuiet
    tables       []TableRows
    done         *string
    hint         *string
    archive      ?ArchiveResult
    order        []string(128)
    times        []PartTime
    took_ns      int64
    busy_retries ?int64
    route_trips  ?int64
    said         []string
}

// MachineOut is machineOut: start's, stop's and tick's report. reason and
// until are a stop by hand's.
table MachineOut
{
    before  string(16)
    after   string(16)
    changed bool
    tick    *TickResult
    notes   int64
    error   *string
    sprint  *string
    refused []Refusal
    moved   []string
    parts   []PartResult
    reason  *string
    until   string(40)
}

// ---- remind.go -----------------------------------------------------------------------------

// RemindView is remindView: one timer for a program. outcome and changed are
// accepted | refused | unknown, and yes | no | unknown.
table RemindView
{
    id      string(128)
    for_    string(135) | json = "for"
    due     string(40)
    note    *string
    by      string(135)
    set     string(40)
    dry_run ?bool
    outcome string(16)
    changed string(16)
}

// MoreView is moreView: the MORE line's counts under --json.
table MoreView
{
    shown int64
    total int64
}

// RemindList is remind --list's object.
table RemindList
{
    items   []RemindView
    more    ?MoreView
    outcome string(16)
    changed string(16)
}

// ---- log.go -----------------------------------------------------------------------------------

// StreamTransition is sprint.StreamTransition.
table StreamTransition
{
    state   string(16)
    cause   *string
    waiting int64
    owners  []string(128)
}

// DecisionDelivery is sprint.DecisionDelivery: a decision's delivery to a lane.
table DecisionDelivery
{
    lane             string(135)
    to               string(135)
    from             string(135)
    set              *string
    body             string(65536)
    token            string(128)
    prepared_at      string(40)
    retry_before     string(40)
    sent_at          string(40)
    fault            *string
    reports          []string
    unknown_receipts ?int64
}

// CoordinatorDelivery is sprint.CoordinatorDelivery; its Go fields carry no
// json tag, so the keys are the Go field names.
table CoordinatorDelivery
{
    covered_by   string(128) | json = "CoveredBy"
    from         string(135) | json = "From"
    to           string(135) | json = "To"
    token        string(128) | json = "Token"
    subject      *string | json = "Subject"
    body         string(65536) | json = "Body"
    episode      string(128) | json = "Episode"
    sent         bool | json = "Sent"
    retry_before string(40) | json = "RetryBefore"
}

// Note is sprint.Note: one notification.
table Note
{
    stream_transition        *StreamTransition
    id                       string(128)
    safe_default             *string
    decision_delivery        *DecisionDelivery
    default_coordinator_told ?bool
    default_owner_told       ?bool
    coordinator_delivery     *CoordinatorDelivery
    alias                    string(16)
    kind                     string(32)
    type_                    string(64) | json = "type"
    stream                   string(128)
    primaries                []string(515)
    count                    int64
    what                     *string
    who                      string(135)
    attempt                  ?int64
    before                   ?int64
    at                       string(40)
    decisions                []string
    marked                   ?bool
    answers                  *string
    suspects                 []string(515)
    card                     string(515)
    other                    string(515)
    tier                     string(16)
    other_stream             string(128)
    stream_level             ?bool
    sprint_level             ?bool
    needs                    []string(515)
    review                   string(40)
    review_set               string(40)
    to                       string(135)
    hint                     *string
}

// LogLine is sprint.Line: one line of the log. cause is at most
// sprint.MaxCause (300); text holds the words a change carries (a brief is at
// most store.MaxBriefBytes, 16 KiB, the rest at most store.MaxCardTextBytes);
// the keys of text and set are field names.
table LogLine
{
    kind    string(32)
    at      string(40)
    epoch   uint64
    op      string(128)
    card    string(515)
    cards   []string(515)
    primary string(515)
    stream  string(128)
    table_  string(32) | json = "table"
    from    *string
    to      *string
    removed ?bool
    gen     ?int64
    actor   string(135)
    verb    string(32)
    cause   string(300)
    answers []string
    text    map[string(32)]string(65536)
    set     map[string(32)]*string
    note    *Note
}

// LogOut is log --json's object.
table LogOut
{
    lines []LogLine
}

// ---- streams.go -------------------------------------------------------------------------------

// StreamCard is sprint.StreamCard.
table StreamCard
{
    id    string(515)
    state string(16)
    tier  string(16)
    title *string
    needs []string(515)
}

// StreamEntry is sprint.StreamEntry.
table StreamEntry
{
    stream  string(128)
    repos   []string
    bases   []string
    release string(128)
    display string(128)
    state   string(16)
    open    int64
    landed  int64
    cards   []StreamCard
}

// StreamsView is sprint.StreamsView: streams --json's object.
table StreamsView
{
    streams []StreamEntry
    mixed   []string
}

// ---- stats.go ---------------------------------------------------------------------------------

// Measure is sprint.Measure: the median, the max and the count of a measure's
// samples, in seconds.
table Measure
{
    median_s float64
    max_s    float64
    n        int64
}

// Stages is sprint.Stages: the primary's stages.
table Stages
{
    deal_wait        Measure
    finish_to_2reads Measure
    accept_to_land   Measure
    total            Measure
}

// MemberStat is sprint.MemberStat.
table MemberStat
{
    member     string(128)
    cards      int64
    failed     int64
    take_wait  Measure
    run_wall   Measure
    report_lag Measure
}

// ReaderStat is sprint.ReaderStat.
table ReaderStat
{
    reader     string(128)
    cards      int64
    begin_wait Measure
    run_wall   Measure
    report_lag Measure
}

// RouteTakes is sprint.RouteTakes.
table RouteTakes
{
    route             string(128)
    takes             int64
    ok                int64
    failed            int64
    provider_failures int64
    run_wall          Measure
}

// PassStats is sprint.PassStats: stats --json's object. since is empty
// until a stats tidy (an optional string(N) is a named follow-on of the
// compiler, so absence is the empty text).
table PassStats
{
    epoch     uint64
    since     string(40)
    primaries int64
    stages    Stages
    work      []MemberStat
    reads     []ReaderStat
    routes    []RouteTakes
}
