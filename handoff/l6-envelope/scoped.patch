+// renderPushEnvelope preserves group counts while applying one recipient-wide limit.
+func renderPushEnvelope(recipient string, batches []pushBatch, observe bool) pushEnvelope {
+	lines := make([]string, 0, maxPushLines+1)
+	bytes, omitted := 0, 0
+	envelope := pushEnvelope{}
+	reserve := len(fmt.Sprintf("and %d more: nova-sprint next --as %s", int64(math.MaxInt64), recipient)) + 1
+	for _, batch := range batches {
+		items := batch.lines
+		if batch.group != "" {
+			items = items[1:]
+		}
+		if batch.omitted > 0 {
+			items = items[:len(items)-1]
+		}
+		omitted += batch.omitted
+		if observe {
+			envelope.Omitted = append(envelope.Omitted, batch.skipped...)
+		}
+		label := batch.subject
+		if batch.group != "" {
+			label += fmt.Sprintf(" group=%s n=%d", batch.group, len(items)+batch.omitted)
+		}
+		for _, item := range items {
+			line := label + ": " + item
+			size := len(line)
+			if len(lines) > 0 {
+				size++
+			}
+			if len(lines) >= maxPushLines || bytes+size+reserve > maxPushBytes {
+				omitted++
+				if observe {
+					envelope.Omitted = append(envelope.Omitted, Notice{Subject: batch.subject, Group: batch.group, Line: item})
+				}
+				continue
+			}
+			lines = append(lines, line)
+			if observe {
+				envelope.Included = append(envelope.Included, Notice{Subject: batch.subject, Group: batch.group, Line: item})
+			}
+			bytes += size
+		}
+	}
+	if omitted > 0 {
+		lines = append(lines, fmt.Sprintf("and %d more: nova-sprint next --as %s", omitted, recipient))
+	}
+	envelope.Subject, envelope.Body = "SPRINT", strings.Join(lines, "\n")
+	return envelope
+}
