------------------------ MODULE StoreJudgementTwice -------------------------
(***************************************************************************)
(* REVERSED WITNESS. FAULT:                                                *)
(* Answer and expire refuse only an absent judgement, not a closed one:    *)
(* h1 answers j1, and h2, which carries no JudgementOpen fence, answers    *)
(* it again.                                                               *)
(* TLC must report JudgementClosedOnce violated. Everything else is        *)
(* Store.tla unchanged (generated by make-witnesses.py).                   *)
(***************************************************************************)
(***************************************************************************)
(* Layer 1 of nova-sprint v2: the store (docs/LAYER-1-STORE.md).           *)
(*                                                                         *)
(* Each operation is one atomic step. In SQL that step is one transaction  *)
(* from LOCK TABLE sprint.epoch to COMMIT at READ COMMITTED: writers are   *)
(* serialized by the lock, so the conditions are read in the same state    *)
(* the writes change. The op's epoch must equal the store's epoch; then    *)
(* its conditions (Expect) are checked; then its writes run in order, each *)
(* under its own rule; then either everything lands and an accepted event  *)
(* is appended, or nothing changes and a refused event is appended. Clear  *)
(* is an op with no writes: it opens the next epoch, carries the rows      *)
(* forward (state down, gen + 1, held kept), keeps the                    *)
(* cursors (global, as the log's seq is) and leaves the cards and          *)
(* judgements behind (both are epoch-scoped). The event log is append-only *)
(* (triggers refuse UPDATE and DELETE, and TRUNCATE by a statement         *)
(* trigger). Policy versions are global: put policy adds the next version, *)
(* and a version's body never changes (a trigger; only active may, and     *)
(* active is left out here). A set write that would change nothing is      *)
(* refused ("already"), so no gen moves for it.                            *)
(* An op id is remembered forever (applied); a second Apply of a           *)
(* remembered id, and a Replay, return the stored receipt and change       *)
(* nothing. A transport failure is the caller not learning the outcome     *)
(* (phase "unknown"): the request was lost before the store saw it, or the *)
(* reply was lost after the store applied it; the caller then calls Replay *)
(* or Apply again.                                                         *)
(*                                                                         *)
(* Cards have a kind: a producer, a sentinel, or a consumer (work or read) *)
(* that names the producer it belongs to (prod, the design's of) and       *)
(* inherits its tier. A consumer's holder is set at add and never changes  *)
(* (there is no holder write); a producer or sentinel has none; a          *)
(* consumer's holder is a row of the epoch. A row is sprint state only     *)
(* (round 22): its state, a gen (once per op that writes the row, fenced   *)
(* by RowGen) and a held flag (RowHeld). Its kind, width, tiers, model and *)
(* harness are configuration, the roster's (nova-config, read each tick),  *)
(* never the store's: the store neither caps a row's working consumers nor *)
(* checks a row serves a tier. The deal guards (card package) do, against  *)
(* the roster; the store's rules here take any number of consumers of any  *)
(* tier on a row that exists. Judgements are open, answered or expired; a  *)
(* close is refused unless the judgement is open (and JudgementOpen fences *)
(* a plan). A cursor never moves back and never passes the log's last seq. *)
(*                                                                         *)
(* A row is hooked by one bus session at a time (round 22): sess and role  *)
(* are put by PutRow, the sprint hook's one write ("" for both, None here, *)
(* is unhooked). A hook by another session while one holds the row is      *)
(* refused (unhook first); the same session may hook again with a new role. *)
(* Session and role both set or both unset, and a role from Roles, is      *)
(* checked before the store's step (ErrInvalid), so it is structural here. *)
(* The sprint's stop (stopped) is one value for the store, as the epoch is, *)
(* set by SetStopped (refused when unchanged) and kept by a clear. The     *)
(* store refuses nothing because of it: ops still land while stopped,      *)
(* except an op fenced on Running (run's tick ops). A fresh store begins   *)
(* stopped, its reason "never started" (Empty.stopped; store.FreshStop,    *)
(* written by Migrate), so nothing a tick plans lands before the first     *)
(* start (FreshMovesNothing; the owner, 2026-11-07).                           *)
(*                                                                         *)
(* A producer carries red (round 17): its last read's verdict was red, a   *)
(* plain attribute set by SetRed (producers only; refused on a consumer or *)
(* a sentinel, and as changing nothing) and read by CardRed.               *)
(*                                                                         *)
(* Small instance: 6 cards (2 producers, 1 sentinel, 3 consumers), 2 rows, *)
(* one judgement, one cursor, two policy versions, 39 fixed ops. A setup   *)
(* caller runs n1, n2, s1..s23 in order, covering the deterministic rules  *)
(* once each; then the callers of one Scenario run concurrently: "deal"   *)
(* (cards                                                                  *)
(* and rows)                                                               *)
(* or "records" (judgements and cursors). The two never interact, and      *)
(* splitting them keeps each run small. Transport failures (at most        *)
(* MaxLoss each) only on a1 and k1 (Lossy). Streams, policy, the seq       *)
(* fence, op times (and so the close-before-opened_at refusal), the soft   *)
(* after list, and the fields no rule reads (attempt,                      *)
(* author, branch, base_sha, prior_head, head, pr, result, bounces, cost,  *)
(* priced, priority, brief, paths, done_when, prose, reason, score,        *)
(* flaps, and a judgement's kind, about,                                   *)
(* question, command, group_key, deadline, answer, actor and times) are    *)
(* left out: they add columns, not behaviour.                              *)
(***************************************************************************)
EXTENDS Naturals, Sequences, FiniteSets

CONSTANT MaxLoss,   \* transport failures allowed per lossy op (bounds the model)
         Scenario   \* "deal" or "records": which concurrent callers run

Cards      == {"p1", "p2", "t1", "u1", "u2", "u3"}
Rows       == {"r1", "r2"}
Judgements == {"j1"}
Cursors    == {"c1"}
CardStates == {"waiting", "ready", "working", "review", "merging", "landed", "fail", "blocked", "done"}
CardKinds  == {"producer", "sentinel", "work", "read"}
Consumers  == {"work", "read"}
Unheld     == {"producer", "sentinel"}   \* kinds that never have a holder
RowStates  == {"up", "down"}
Tiers      == {"flash", "pro", "heavy", "frontier"}
MaxSeq    == 40   \* m3 sets a cursor here: past any log this instance can write
Versions   == 1..2           \* policy versions this instance can hold
Bodies     == {"a", "b"}     \* policy bodies
JStates    == {"open", "answered", "expired"}
Absent     == "absent"   \* the state of a card, row or judgement that does not exist
NoHolder   == "none"
None       == "-"        \* an unused field
Sessions   == {"x", "y"}                \* bus sessions a hook records
Roles      == {"worker", "coordinator"} \* a hooked row's role

(* Conditions and writes are uniform records so TLC can compare them. In a *)
(* condition, g is the gen for CardGen and RowGen, and 1 or 0 for RowHeld; *)
(* s is the state for CardState and RowIs; c is the card, or the           *)
(* judgement for JudgementOpen. There is no tier or width condition: both  *)
(* are the roster's (round 22).                                            *)
Cnd(k, c, r, s, g) == [k |-> k, c |-> c, r |-> r, s |-> s, g |-> g]
CardGen(c, g)     == Cnd("cardGen",     c,    None, None, g)
CardState(c, s)   == Cnd("cardState",   c,    None, s,    0)
HolderIs(c, r)    == Cnd("holderIs",    c,    r,    None, 0)
NeedsLanded(c)    == Cnd("needsLanded", c,    None, None, 0)
CardAbsent(c)     == Cnd("cardAbsent",  c,    None, None, 0)
RowIs(r, s)       == Cnd("rowIs",       None, r,    s,    0)
RowGen(r, g)      == Cnd("rowGen",      None, r,    None, g)
RowHeld(r, h)     == Cnd("rowHeld",     None, r,    None, IF h THEN 1 ELSE 0)
JudgementOpen(j)  == Cnd("judgeOpen",   j,    None, None, 0)
CardRed(c, b)     == Cnd("cardRed",     c,    None, None, IF b THEN 1 ELSE 0)
Running           == Cnd("running",     None, None, None, 0)   \* the sprint is not stopped

(* A write: k the kind; c the card, judgement or cursor; r the row (and a  *)
(* consumer's holder at add); s a state, or a producer's tier at add; n    *)
(* needs at add; s also a policy body; w held as 1 or 0, red as 1 or 0, or *)
(* a cursor value; kd a card kind; p a consumer's producer.                *)
Wr(k, c, r, s, n, w, kd, p) == [k |-> k, c |-> c, r |-> r, s |-> s, n |-> n, w |-> w, kd |-> kd, p |-> p]
AddCard(c, kd, p, n, h, t) == Wr("addCard",  c,    h,    t,    n,  0, kd,   p)
SetState(c, s)       == Wr("setState",    c,    None, s,    {}, 0, None, None)
PutRow(r, x, ro)     == Wr("putRow",      None, r,    x,    {}, 0, ro,   None)   \* x the session, ro the role; None, None unhooks
SetStopped(b)        == Wr("setStopped",  None, None, None, {}, IF b THEN 1 ELSE 0, None, None)
SetRowState(r, s)    == Wr("setRowState", None, r,    s,    {}, 0, None, None)
SetRowHeld(r, h)     == Wr("setRowHeld",  None, r,    None, {}, IF h THEN 1 ELSE 0, None, None)
PutJudgement(j)     == Wr("putJudge",    j,    None, None, {}, 0, None, None)
AnswerJudgement(j)   == Wr("closeJudge",  j,    None, "answered", {}, 0, None, None)
ExpireJudgement(j)   == Wr("closeJudge",  j,    None, "expired",  {}, 0, None, None)
SetCursor(x, v)      == Wr("setCursor",   x,    None, None, {}, v, None, None)
PutPolicy(b)         == Wr("putPolicy",   None, None, b,    {}, 0, None, None)
SetRed(c, b)         == Wr("setRed",      c,    None, None, {}, IF b THEN 1 ELSE 0, None, None)
CardWrites == {"addCard", "setState", "setRed"}
RowWrites  == {"putRow", "setRowState", "setRowHeld"}

Op(e, x, w)  == [kind |-> "op",    epoch |-> e, expect |-> x,  writes |-> w]
ClearOp(e)   == [kind |-> "clear", epoch |-> e, expect |-> {}, writes |-> <<>>]

(* Setup, in order: s1, s2 put rows r1 and r2, up. s3 adds producer p1    *)
(* with a holder, s4 sentinel t1 with a holder: both refused. s5 adds p1   *)
(* (tier pro). s6 adds producer p2 (needs p1) and sentinel t1 (needs p2).  *)
(* s7 readies p2 before its need is landed: refused. s8 lands p1. s9       *)
(* readies p2. s10 adds consumer u3 on r1 and readies it. s11 opens j1.    *)
(* s12 and s13 put policy versions 1 (a) and 2 (b). s14 sets p2 red,       *)
(* fenced on CardRed(p2, FALSE); s15 sets the consumer u3 red and s16 the  *)
(* sentinel t1: both refused by the write; s17, fenced on                  *)
(* CardRed(p2, TRUE), sets p2 red again: refused as changing nothing.      *)
(* Needs are TLA+ sets, so a reorder is the same value by construction     *)
(* (the store keeps them sorted without repeats). An empty name is         *)
(* ErrInvalid before the store's step, so it never reaches the model       *)
(* (structural). Round 22 removed the width and tier ops (old s10, s13 to  *)
(* s17, s20, e1's width write, v1) and renumbered the rest. s1 and s2     *)
(* hook r1 and r2 by session x as workers; s18 hooks r2 by y: refused, x   *)
(* holds it; s19 unhooks r2; s20 hooks it by y as coordinator. s21 stops   *)
(* the sprint; s22 stops it again: refused as changing nothing. s23, fenced *)
(* on Running (run's tick ops carry it), is refused: the sprint is stopped. *)
(* The deal scenario then runs stopped: unfenced ops still land. Before    *)
(* all of them, on the fresh store: n1, a tick op fenced on Running (run   *)
(* opens a judgement), is refused: the sprint was never started; n2 is the *)
(* coordinator's first start.                                              *)
(* Scenario "deal": a1 deals new consumer u1 to r1 and makes it working,   *)
(* fenced on r1 up and not held; a2 marks it done (it keeps r1). b1 adds   *)
(* consumer u2 ready on r1, b2 makes it working: with a1's u1 still        *)
(* working the store takes both on r1 (width is the roster's). e1 sets r1  *)
(* down and g1 holds r1, both fenced on RowGen(r1, 0). k1 clears epoch 1;  *)
(* k2 adds p1 again in epoch 2. Scenario "records": h1 answers j1 and y1   *)
(* expires it, each fenced on JudgementOpen(j1); h2 answers j1 with no     *)
(* fence (the write refuses a second close); m1 sets cursor c1 to 2, m2 to *)
(* 1, m3 to MaxSeq (past the log); k1 clears epoch 1 (the cursor is kept). *)
Ops == [
  n1  |-> Op(1, {Running}, <<PutJudgement("j1")>>),
  n2  |-> Op(1, {}, <<SetStopped(FALSE)>>),
  s1  |->Op(1, {}, <<PutRow("r1", "x", "worker"), SetRowState("r1", "up")>>),
  s2  |-> Op(1, {}, <<PutRow("r2", "x", "worker"), SetRowState("r2", "up")>>),
  s3  |-> Op(1, {}, <<AddCard("p1", "producer", None, {}, "r1", "pro")>>),
  s4  |-> Op(1, {}, <<AddCard("t1", "sentinel", None, {}, "r1", "pro")>>),
  s5  |-> Op(1, {CardAbsent("p1")}, <<AddCard("p1", "producer", None, {}, NoHolder, "pro")>>),
  s6  |-> Op(1, {CardAbsent("p2")}, <<AddCard("p2", "producer", None, {"p1"}, NoHolder, "pro"),
                                      AddCard("t1", "sentinel", None, {"p2"}, NoHolder, "pro")>>),
  s7  |-> Op(1, {CardState("p2", "waiting"), NeedsLanded("p2")}, <<SetState("p2", "ready")>>),
  s8  |-> Op(1, {CardState("p1", "waiting")}, <<SetState("p1", "landed")>>),
  s9  |-> Op(1, {CardState("p2", "waiting"), NeedsLanded("p2")}, <<SetState("p2", "ready")>>),
  s10 |-> Op(1, {}, <<AddCard("u3", "work", "p2", {}, "r1", None), SetState("u3", "ready")>>),
  s11 |-> Op(1, {}, <<PutJudgement("j1")>>),
  s12 |-> Op(1, {}, <<PutPolicy("a")>>),
  s13 |-> Op(1, {}, <<PutPolicy("b")>>),
  s14 |-> Op(1, {CardRed("p2", FALSE)}, <<SetRed("p2", TRUE)>>),
  s15 |-> Op(1, {}, <<SetRed("u3", TRUE)>>),
  s16 |-> Op(1, {}, <<SetRed("t1", TRUE)>>),
  s17 |-> Op(1, {CardRed("p2", TRUE)}, <<SetRed("p2", TRUE)>>),
  s18 |-> Op(1, {}, <<PutRow("r2", "y", "coordinator")>>),
  s19 |-> Op(1, {}, <<PutRow("r2", None, None)>>),
  s20 |-> Op(1, {}, <<PutRow("r2", "y", "coordinator")>>),
  s21 |-> Op(1, {}, <<SetStopped(TRUE)>>),
  s22 |-> Op(1, {}, <<SetStopped(TRUE)>>),
  s23 |-> Op(1, {Running}, <<SetRed("u3", FALSE)>>),
  a1  |-> Op(1, {CardAbsent("u1"), RowIs("r1", "up"), RowHeld("r1", FALSE)},
              <<AddCard("u1", "work", "p2", {}, "r1", None), SetState("u1", "working")>>),
  a2  |-> Op(1, {CardState("u1", "working")}, <<SetState("u1", "done")>>),
  b1  |-> Op(1, {CardAbsent("u2")}, <<AddCard("u2", "read", "p2", {}, "r1", None), SetState("u2", "ready")>>),
  b2  |-> Op(1, {CardState("u2", "ready")}, <<SetState("u2", "working")>>),
  e1  |-> Op(1, {RowGen("r1", 0)}, <<SetRowState("r1", "down")>>),
  g1  |-> Op(1, {RowGen("r1", 0)}, <<SetRowHeld("r1", TRUE)>>),
  k1  |-> ClearOp(1),
  k2  |-> Op(2, {CardAbsent("p1")}, <<AddCard("p1", "producer", None, {}, NoHolder, "pro")>>),
  h1  |-> Op(1, {JudgementOpen("j1")}, <<AnswerJudgement("j1")>>),
  h2  |-> Op(1, {}, <<AnswerJudgement("j1")>>),
  y1  |-> Op(1, {JudgementOpen("j1")}, <<ExpireJudgement("j1")>>),
  m1  |-> Op(1, {}, <<SetCursor("c1", 2)>>),
  m2  |-> Op(1, {}, <<SetCursor("c1", 1)>>),
  m3  |-> Op(1, {}, <<SetCursor("c1", MaxSeq)>>)
]
OpIds == DOMAIN Ops
SetupSeq == <<"n1", "n2", "s1", "s2","s3", "s4", "s5", "s6", "s7", "s8", "s9", "s10", "s11", "s12",
              "s13", "s14", "s15", "s16", "s17", "s18", "s19", "s20", "s21", "s22", "s23">>
Setup == {SetupSeq[i] : i \in DOMAIN SetupSeq}
Active == Setup \cup (IF Scenario = "deal"
                      THEN {"a1", "a2", "b1", "b2", "e1", "g1", "k1", "k2"}
                      ELSE {"h1", "h2", "y1", "m1", "m2", "m3", "k1"})
Lossy == {"a1", "k1"}   \* ops whose transport can fail: one deal, the clear

(* Program order: an op is asked for only once these ops are done.         *)
Pred(o) ==
  IF o \in Setup
  THEN {SetupSeq[j] : j \in {i \in DOMAIN SetupSeq : \E m \in DOMAIN SetupSeq :
                                SetupSeq[m] = o /\ i < m}}
  ELSE Setup \cup (CASE o = "a2" -> {"a1"} [] o = "b2" -> {"b1"} [] o = "k2" -> {"k1"}
                        [] OTHER -> {})

NoCard == [state |-> Absent, gen |-> 0, holder |-> NoHolder, needs |-> {}, kind |-> None, prod |-> None,
           tier |-> None, red |-> FALSE]
NoRow  == [state |-> Absent, gen |-> 0, held |-> FALSE, sess |-> None, role |-> None]
Empty  == [epoch |-> 1, cards |-> [c \in Cards |-> NoCard], rows |-> [r \in Rows |-> NoRow],
           judgements |-> [j \in Judgements |-> Absent], cursors |-> [x \in Cursors |-> 0],
           policies |-> [v \in Versions |-> Absent], stopped |-> TRUE]   \* a fresh store: never started

Exists(st, c) == st.cards[c].state # Absent

Cond(st, x) ==
  CASE x.k = "cardGen"     -> Exists(st, x.c) /\ st.cards[x.c].gen = x.g
    [] x.k = "cardState"   -> st.cards[x.c].state = x.s
    [] x.k = "holderIs"    -> Exists(st, x.c) /\ st.cards[x.c].holder = x.r
    [] x.k = "needsLanded" -> Exists(st, x.c)
                              /\ \A n \in st.cards[x.c].needs : st.cards[n].state = "landed"
    [] x.k = "cardAbsent"  -> ~Exists(st, x.c)
    [] x.k = "rowIs"       -> st.rows[x.r].state = x.s
    [] x.k = "rowGen"      -> st.rows[x.r].state # Absent /\ st.rows[x.r].gen = x.g
    [] x.k = "rowHeld"     -> st.rows[x.r].state # Absent /\ st.rows[x.r].held = (x.g = 1)
    [] x.k = "judgeOpen"   -> st.judgements[x.c] = "open"
    [] x.k = "cardRed"     -> Exists(st, x.c) /\ st.cards[x.c].red = (x.g = 1)
    [] x.k = "running"     -> ~st.stopped

Holds(st, conds) == \A x \in conds : Cond(st, x)

(* The write rules. A card is added only if absent, with needs that name   *)
(* other cards of this epoch; a consumer names an existing producer, has   *)
(* no needs and is added with a holder, a row of this epoch (the foreign   *)
(* key); a producer or sentinel names no producer, has no holder and       *)
(* carries a tier. Whether the row serves the tier or has room is the      *)
(* roster's (round 22), checked at the deal, never here. A set write needs *)
(* its target. A state is in the closed set and differs from the card's    *)
(* own. Put row takes any row. A judgement is put only if absent; answer   *)
(* and expire need it open. A cursor never moves back (its upper bound,    *)
(* the log's last seq, is checked in Outcome, which sees the log). Put     *)
(* policy adds the next version (bounded by the instance, never reached).  *)
NextVersion(st) == Cardinality({v \in Versions : st.policies[v] # Absent}) + 1

WriteRule(st, w) ==
  \* A bulleted list, so a quantifier's body ends at its own line.
  CASE w.k = "addCard"     -> /\ ~Exists(st, w.c)
                              /\ w.c \notin w.n
                              /\ \A x \in w.n : Exists(st, x)
                              /\ w.kd \in CardKinds
                              /\ IF w.kd \in Unheld
                                 THEN /\ w.p = None
                                      /\ w.r = NoHolder
                                      /\ w.s \in Tiers
                                 ELSE /\ w.n = {}
                                      /\ w.p \in Cards
                                      /\ Exists(st, w.p)
                                      /\ st.cards[w.p].kind = "producer"
                                      /\ w.r \in Rows
                                      /\ st.rows[w.r].state # Absent
    [] w.k = "setState"    -> Exists(st, w.c) /\ w.s \in CardStates
    [] w.k = "setRed"      -> Exists(st, w.c) /\ st.cards[w.c].kind = "producer"
    [] w.k = "putRow"      -> ~(/\ st.rows[w.r].state # Absent
                                /\ st.rows[w.r].sess # None
                                /\ w.s # None
                                /\ w.s # st.rows[w.r].sess)
    [] w.k = "setStopped"  -> TRUE
    [] w.k = "setRowState" -> st.rows[w.r].state # Absent /\ w.s \in RowStates
    [] w.k = "setRowHeld"  -> st.rows[w.r].state # Absent
    [] w.k = "putJudge"   -> st.judgements[w.c] = Absent
    [] w.k = "closeJudge"  -> st.judgements[w.c] # Absent   \* FAULT: a closed one too
    [] w.k = "setCursor"   -> w.w >= st.cursors[w.c]
    [] w.k = "putPolicy"   -> w.s \in Bodies /\ NextVersion(st) \in Versions

(* A set write must change its field: one that would leave the record as   *)
(* it is is refused ("row r1 is already up"; "cursor c1 is already at 2"). *)
Changes(st, w) ==
  CASE w.k = "setState"    -> w.s # st.cards[w.c].state
    [] w.k = "setRed"      -> (w.w = 1) # st.cards[w.c].red
    [] w.k = "setRowState" -> w.s # st.rows[w.r].state
    [] w.k = "setRowHeld"  -> (w.w = 1) # st.rows[w.r].held
    [] w.k = "setCursor"   -> w.w # st.cursors[w.c]
    [] w.k = "setStopped"  -> (w.w = 1) # st.stopped
    [] OTHER               -> TRUE

RuleLegal(st, w) == Changes(st, w) /\ WriteRule(st, w)

(* The store's rules (what runs) and the spec's rules (what the design     *)
(* says). They are the same here; a witness changes only Legal, so         *)
(* NoSpuriousRefusal can catch a rule that refuses what the spec allows    *)
(* (StoreWidthInStore: a width cap the store no longer owns).              *)
Legal(st, w)     == RuleLegal(st, w)
SpecLegal(st, w) == RuleLegal(st, w)

(* gen is raised once per op, in RunOp below. A put row inserts a row as   *)
(* down, not held, at gen 0 (the design's default: up once the run loop    *)
(* sees its hook); on an existing row it changes nothing the model holds   *)
(* (its session is left out) but still raises the gen. A consumer takes    *)
(* its producer's tier at add.                                             *)
Do(st, w) ==
  CASE w.k = "addCard"     -> [st EXCEPT !.cards[w.c] =
                                 [state |-> "waiting", gen |-> 0, holder |-> w.r,
                                  needs |-> w.n, kind |-> w.kd, prod |-> w.p,
                                  tier |-> IF w.kd \in Unheld THEN w.s ELSE st.cards[w.p].tier,
                                  red |-> FALSE]]
    [] w.k = "setState"    -> [st EXCEPT !.cards[w.c].state = w.s]
    [] w.k = "setRed"      -> [st EXCEPT !.cards[w.c].red = (w.w = 1)]
    [] w.k = "putRow"      -> [st EXCEPT !.rows[w.r] =
                                 IF @.state = Absent
                                 THEN [state |-> "down", gen |-> 0, held |-> FALSE, sess |-> w.s, role |-> w.kd]
                                 ELSE [@ EXCEPT !.sess = w.s, !.role = w.kd]]
    [] w.k = "setStopped"  -> [st EXCEPT !.stopped = (w.w = 1)]
    [] w.k = "setRowState" -> [st EXCEPT !.rows[w.r].state = w.s]
    [] w.k = "setRowHeld"  -> [st EXCEPT !.rows[w.r].held = (w.w = 1)]
    [] w.k = "putJudge"    -> [st EXCEPT !.judgements[w.c] = "open"]
    [] w.k = "closeJudge"  -> [st EXCEPT !.judgements[w.c] = w.s]
    [] w.k = "setCursor"   -> [st EXCEPT !.cursors[w.c] = w.w]
    [] w.k = "putPolicy"   -> [st EXCEPT !.policies[NextVersion(st)] = w.s]

(* Run the writes in order; a write that breaks a rule refuses the op.     *)
RECURSIVE Run(_, _)
Run(st, ws) ==
  IF ws = <<>> THEN [ok |-> TRUE, st |-> st]
  ELSE IF Legal(st, Head(ws)) THEN Run(Do(st, Head(ws)), Tail(ws))
  ELSE [ok |-> FALSE, st |-> st]

RECURSIVE SpecRun(_, _)
SpecRun(st, ws) ==
  IF ws = <<>> THEN [ok |-> TRUE, st |-> st]
  ELSE IF SpecLegal(st, Head(ws)) THEN SpecRun(Do(st, Head(ws)), Tail(ws))
  ELSE [ok |-> FALSE, st |-> st]

(* The cards and rows an op writes. An op that writes a card or row that   *)
(* existed before it raises that gen by one, however many of its writes    *)
(* touch it; one the op itself creates stays at gen 0.                     *)
CardsWritten(ws) == {ws[i].c : i \in {j \in DOMAIN ws : ws[j].k \in CardWrites}}
RowsWritten(ws)  == {ws[i].r : i \in {j \in DOMAIN ws : ws[j].k \in RowWrites}}

(* post with the gens raised: by one for each card and row of ws that      *)
(* existed in st, the state before the op.                                 *)
Bump(st, post, ws) ==
  [post EXCEPT
     !.cards = [c \in Cards |->
       IF c \in CardsWritten(ws) /\ Exists(st, c)
       THEN [post.cards[c] EXCEPT !.gen = @ + 1] ELSE post.cards[c]],
     !.rows = [x \in Rows |->
       IF x \in RowsWritten(ws) /\ st.rows[x].state # Absent
       THEN [post.rows[x] EXCEPT !.gen = @ + 1] ELSE post.rows[x]]]

RunOp(st, ws) ==
  LET r == Run(st, ws)
  IN IF ~r.ok THEN r ELSE [ok |-> TRUE, st |-> Bump(st, r.st, ws)]

(* Rebuild's half: the writes applied in order, no rule checked.           *)
RECURSIVE DoAll(_, _)
DoAll(st, ws) == IF ws = <<>> THEN st ELSE DoAll(Do(st, Head(ws)), Tail(ws))

(* Clear: the next epoch, the rows carried forward as down with gen + 1    *)
(* (the clear writes them) and held kept; no cards or                      *)
(* judgements (keyed by epoch, not carried); cursors and policies kept     *)
(* (global).                                                               *)
ClearState(st) ==
  [epoch |-> st.epoch + 1,
   cards |-> [c \in Cards |-> NoCard],
   rows  |-> [r \in Rows |-> IF st.rows[r].state = Absent THEN NoRow
                             ELSE [st.rows[r] EXCEPT !.state = "down", !.gen = @ + 1]],
   judgements |-> [j \in Judgements |-> Absent],
   cursors |-> st.cursors,
   policies |-> st.policies,
   stopped |-> st.stopped]

(* Every cursor write of ws stays at or below last, the seq of the last    *)
(* event logged before the op (events are numbered 1, 2, ... in the log,   *)
(* refused ones included).                                                 *)
CursorsFit(ws, last) ==
  \A k \in DOMAIN ws : ws[k].k = "setCursor" => ws[k].w <= last

(* What the store does with op o in state st, last being the seq of the    *)
(* last event: accept with a new state, or refuse. The epoch check comes   *)
(* first.                                                                  *)
Outcome(st, o, last) ==
  IF Ops[o].epoch # st.epoch THEN [acc |-> FALSE, st |-> st]
  ELSE IF Ops[o].kind = "clear" THEN [acc |-> TRUE, st |-> ClearState(st)]
  ELSE LET run == RunOp(st, Ops[o].writes)
       IN IF Holds(st, Ops[o].expect) /\ run.ok /\ CursorsFit(Ops[o].writes, last)
          THEN [acc |-> TRUE, st |-> run.st]
          ELSE [acc |-> FALSE, st |-> st]

(* Rebuild applies an accepted event's writes (a clear the same way the    *)
(* store applies it); it never rechecks the conditions or the write rules. *)
Effect(st, o) ==
  IF Ops[o].kind = "clear" THEN ClearState(st)
  ELSE Bump(st, DoAll(st, Ops[o].writes), Ops[o].writes)

NoReceipt == [id |-> "none", accepted |-> FALSE, epoch |-> 0, before |-> Empty, after |-> Empty]

VARIABLES
  epoch,      \* the store's epoch (sprint.epoch.n)
  cards,      \* card id -> [state, gen, holder, needs, kind, prod, tier, red] in the current epoch
  rows,       \* row name -> [state, gen, held, sess, role] in the current epoch
  judgements, \* judgement id -> Absent | open | answered | expired in the current epoch
  cursors,    \* cursor name -> seq (0 when never set); global
  policies,   \* policy version -> body (Absent until put); global
  stopped,    \* the sprint is stopped (SetStopped); global, kept by a clear
  events,     \* the events table: a sequence of [id, accepted, epoch, before, after]
  ledger,     \* ghost: every event as it was committed, in order (what LogAppendOnly compares)
  applied,    \* op ids the store has seen (the unique op column of events)
  phase,      \* op id -> "idle" | "unknown" | "done": what the caller knows
  receipt,    \* op id -> the receipt the caller holds (NoReceipt until done)
  lost        \* op id -> transport failures so far (bounded by MaxLoss)

store == <<epoch, cards, rows, judgements, cursors, policies, stopped>>
vars == <<epoch, cards, rows, judgements, cursors, policies, stopped, events, ledger, applied, phase, receipt, lost>>
Current == [epoch |-> epoch, cards |-> cards, rows |-> rows, judgements |-> judgements,
            cursors |-> cursors, policies |-> policies, stopped |-> stopped]
(* The state the log says held just before event i: empty before the       *)
(* first, otherwise the after-state of the one before it.                  *)
Before(i) == IF i = 1 THEN Empty ELSE events[i - 1].after

StoredEvent(o) == events[CHOOSE i \in DOMAIN events : events[i].id = o]

Init ==
  /\ epoch      = Empty.epoch
  /\ cards      = Empty.cards
  /\ rows       = Empty.rows
  /\ judgements = Empty.judgements
  /\ cursors    = Empty.cursors
  /\ policies   = Empty.policies
  /\ stopped    = Empty.stopped
  /\ events     = <<>>
  /\ ledger     = <<>>
  /\ applied    = {}
  /\ phase      = [o \in OpIds |-> "idle"]
  /\ receipt    = [o \in OpIds |-> NoReceipt]
  /\ lost       = [o \in OpIds |-> 0]

Ready(o) == o \in Active /\ \A p \in Pred(o) : phase[p] = "done"
CanLose(o) == o \in Lossy /\ lost[o] < MaxLoss

(* The caller learns the outcome, or (while failures remain) does not.     *)
Outcomes(o) == IF CanLose(o) THEN {"done", "unknown"} ELSE {"done"}

(* Replay: the stored receipt comes back; nothing in the store changes.    *)
ReplayEffect(o) ==
  /\ phase'   = [phase EXCEPT ![o] = "done"]
  /\ receipt' = [receipt EXCEPT ![o] = StoredEvent(o)]
  /\ UNCHANGED <<store, events, ledger, applied, lost>>

(* One transaction, lock to commit: epoch, conditions, writes, event.      *)
Execute(o) ==
  LET pre  == Current
      out  == Outcome(pre, o, Len(events))
      post == out.st
      ev   == [id |-> o, accepted |-> out.acc, epoch |-> pre.epoch, before |-> pre, after |-> post]
  IN /\ epoch'      = post.epoch
     /\ cards'      = post.cards
     /\ rows'       = post.rows
     /\ judgements' = post.judgements
     /\ cursors'    = post.cursors
     /\ policies'   = post.policies
     /\ stopped'    = post.stopped
     /\ events'  = Append(events, ev)
     /\ ledger'  = Append(ledger, ev)
     /\ applied' = applied \cup {o}
     /\ \E res \in Outcomes(o) :
          /\ phase'   = [phase EXCEPT ![o] = res]
          /\ receipt' = IF res = "done" THEN [receipt EXCEPT ![o] = ev] ELSE receipt
          /\ lost'    = IF res = "unknown" THEN [lost EXCEPT ![o] = @ + 1] ELSE lost

(* Apply of an id already in applied is the same as Replay.                *)
Apply(o) ==
  /\ phase[o] \in {"idle", "unknown"}
  /\ Ready(o)
  /\ IF o \in applied THEN ReplayEffect(o) ELSE Execute(o)

(* The request is lost before the store sees it: nothing changes, and the  *)
(* caller does not know that.                                              *)
LoseRequest(o) ==
  /\ phase[o] \in {"idle", "unknown"}
  /\ Ready(o)
  /\ CanLose(o)
  /\ phase' = [phase EXCEPT ![o] = "unknown"]
  /\ lost'  = [lost EXCEPT ![o] = @ + 1]
  /\ UNCHANGED <<store, events, ledger, applied, receipt>>

(* Replay after unknown. When the id is not in applied, Replay says "not   *)
(* found" and changes nothing; the caller then calls Apply again, which    *)
(* stays enabled in phase "unknown", so that is not a separate step.       *)
Replay(o) ==
  /\ phase[o] = "unknown"
  /\ o \in applied
  /\ ReplayEffect(o)

Terminating == (\A o \in Active : phase[o] = "done") /\ UNCHANGED vars

Next ==
  \/ \E o \in OpIds : Apply(o) \/ LoseRequest(o) \/ Replay(o)
  \/ Terminating

Spec == Init /\ [][Next]_vars

-----------------------------------------------------------------------------
(* Invariants                                                              *)

Gens == 0..2 * Cardinality(OpIds)

StoreState ==
  [epoch : 0..Cardinality(OpIds),
   cards : [Cards -> [state : CardStates \cup {Absent}, gen : Gens,
                      holder : Rows \cup {NoHolder}, needs : SUBSET Cards,
                      kind : CardKinds \cup {None}, prod : Cards \cup {None},
                      tier : Tiers \cup {None}, red : BOOLEAN]],
   rows : [Rows -> [state : RowStates \cup {Absent}, gen : Gens, held : BOOLEAN,
                    sess : Sessions \cup {None}, role : Roles \cup {None}]],
   judgements : [Judgements -> JStates \cup {Absent}],
   cursors : [Cursors -> 0..MaxSeq],
   policies : [Versions -> Bodies \cup {Absent}],
   stopped : BOOLEAN]

TypeOK ==
  /\ Current \in StoreState
  /\ applied \subseteq OpIds
  /\ phase \in [OpIds -> {"idle", "unknown", "done"}]
  /\ lost \in [OpIds -> 0..MaxLoss]

(* Every card has exactly one state and at most one holder, and the holder *)
(* is a row of this epoch. Structural here (state is one value from the    *)
(* closed set, holder is one value or none, set at add and never written   *)
(* again); stated anyway.                                                  *)
SingleStateSingleHolder ==
  \A c \in Cards :
    /\ cards[c].state \in CardStates \cup {Absent}
    /\ cards[c].holder \in Rows \cup {NoHolder}
    /\ cards[c].holder # NoHolder => rows[cards[c].holder].state # Absent
    /\ cards[c].state = Absent => cards[c] = NoCard

(* A producer or a sentinel never has a holder.                            *)
ProducerNeverHeld ==
  \A c \in Cards : cards[c].kind \in Unheld => cards[c].holder = NoHolder

(* Only a producer is ever red (round 17): the write refuses every other   *)
(* kind, and a card is added not red.                                      *)
RedOnlyOnProducers ==
  \A c \in Cards : cards[c].red => cards[c].kind = "producer"

(* A consumer names an existing producer of this epoch, has no needs, has  *)
(* a holder and has its producer's tier; a producer or sentinel names no   *)
(* producer.                                                               *)
ConsumersWellFormed ==
  \A c \in Cards :
    /\ cards[c].kind \in Unheld => cards[c].prod = None
    /\ cards[c].kind \in Consumers =>
         /\ cards[c].needs = {}
         /\ cards[c].prod \in Cards
         /\ cards[cards[c].prod].kind = "producer"
         /\ cards[c].holder \in Rows
         /\ cards[c].tier = cards[cards[c].prod].tier

(* No op id appears twice in the event log.                                *)
IdempotentById ==
  \A i, j \in DOMAIN events : i # j => events[i].id # events[j].id

(* The set of op ids the store remembers is exactly the ids in the log.    *)
AppliedIsLog == applied = {events[i].id : i \in DOMAIN events}

(* Folding the accepted events from empty (a clear the same way the store  *)
(* applies it) gives the current state. Checked as a chain, which is the   *)
(* fold by induction and linear in the log: the first event starts from    *)
(* empty, each starts where the one before ended, each accepted event's    *)
(* after is its writes applied to its before, and the last one ends at the *)
(* current state. Each event records the epoch it ran in.                  *)
LogMatchesState ==
  /\ (IF events = <<>> THEN Empty ELSE events[Len(events)].after) = Current
  /\ \A i \in DOMAIN events :
       /\ events[i].before = Before(i)
       /\ events[i].after = IF events[i].accepted THEN Effect(Before(i), events[i].id)
                            ELSE Before(i)
       /\ events[i].epoch = Before(i).epoch

(* Every accepted op, clear included, was planned against the epoch the    *)
(* store was at when it applied; so after a clear, a delayed op planned    *)
(* against the old epoch is refused.                                       *)
OpsInTheirEpoch ==
  \A i \in DOMAIN events :
    events[i].accepted => Ops[events[i].id].epoch = Before(i).epoch

(* An accepted op's conditions held against the state immediately before   *)
(* its own writes (where the event before it ended): no lost update.       *)
ConditionsAtomic ==
  \A i \in DOMAIN events :
    events[i].accepted => Holds(Before(i), Ops[events[i].id].expect)

(* A refused op changed nothing: its before and after are equal and are    *)
(* the state immediately before it.                                        *)
NoChangeOnRefusal ==
  \A i \in DOMAIN events :
    ~events[i].accepted =>
      /\ events[i].before = events[i].after
      /\ events[i].before = Before(i)

(* Every refusal has a cause in the spec: the epoch was wrong, a condition *)
(* failed, or a write broke a rule as the design states the rules. A store *)
(* rule stricter than the spec (a width cap the roster owns) breaks this.  *)
NoSpuriousRefusal ==
  \A i \in DOMAIN events :
    ~events[i].accepted =>
      LET o == events[i].id IN
        \/ Ops[o].epoch # Before(i).epoch
        \/ (Ops[o].kind = "op" /\ ~Holds(Before(i), Ops[o].expect))
        \/ (Ops[o].kind = "op" /\ ~SpecRun(Before(i), Ops[o].writes).ok)
        \/ (Ops[o].kind = "op" /\ ~CursorsFit(Ops[o].writes, i - 1))

(* gen counts the ops that changed a card or row: each accepted op raises  *)
(* the gen of every card and row it writes that existed before it by       *)
(* exactly one; one it creates is at 0; a clear raises every carried row's *)
(* gen by one. Checked from the log against the op's writes.               *)
GenPerOp ==
  \A i \in DOMAIN events :
    LET b == events[i].before  a == events[i].after  o == events[i].id IN
    events[i].accepted =>
      IF Ops[o].kind = "clear"
      THEN \A r \in Rows : b.rows[r].state # Absent => a.rows[r].gen = b.rows[r].gen + 1
      ELSE /\ \A c \in Cards :
                a.cards[c].gen = IF b.cards[c].state = Absent THEN 0
                                 ELSE IF c \in CardsWritten(Ops[o].writes) THEN b.cards[c].gen + 1
                                 ELSE b.cards[c].gen
           /\ \A r \in Rows :
                a.rows[r].gen = IF b.rows[r].state = Absent THEN 0
                                ELSE IF r \in RowsWritten(Ops[o].writes) THEN b.rows[r].gen + 1
                                ELSE b.rows[r].gen

(* A clear carries every row forward: the same held flag, state down; a    *)
(* row that did not exist stays absent; no card or judgement survives;     *)
(* every cursor is kept.                                                   *)
ClearCarriesRows ==
  \A i \in DOMAIN events :
    LET b == events[i].before  a == events[i].after IN
    (events[i].accepted /\ Ops[events[i].id].kind = "clear") =>
      /\ \A c \in Cards : a.cards[c] = NoCard
      /\ a.judgements = Empty.judgements
      /\ a.cursors = b.cursors
      /\ a.policies = b.policies
      /\ a.stopped = b.stopped
      /\ \A r \in Rows :
           IF b.rows[r].state = Absent THEN a.rows[r] = NoRow
           ELSE /\ a.rows[r].state = "down"
                /\ a.rows[r].held = b.rows[r].held
                /\ a.rows[r].sess = b.rows[r].sess
                /\ a.rows[r].role = b.rows[r].role

(* A row is hooked by one session at a time: no accepted op moves a row   *)
(* from one session straight to another; it is unhooked (None) between.    *)
HookKept ==
  \A i \in DOMAIN events :
    LET b == events[i].before  a == events[i].after IN
    events[i].accepted =>
      \A r \in Rows : (b.rows[r].state # Absent /\ b.rows[r].sess # None /\ a.rows[r].sess # None)
                       => a.rows[r].sess = b.rows[r].sess

(* A fresh store moves nothing: it begins stopped (never started), so no   *)
(* op fenced on Running (a tick's) is accepted before an accepted start.   *)
Starts(o) == \E k \in DOMAIN Ops[o].writes :
               Ops[o].writes[k].k = "setStopped" /\ Ops[o].writes[k].w = 0
FreshMovesNothing ==
  \A i \in DOMAIN events :
    (events[i].accepted /\ Running \in Ops[events[i].id].expect)
      => \E k \in 1..(i - 1) : events[k].accepted /\ Starts(events[k].id)

(* The ops that close judgement j (answer or expire it).                   *)
Closes(o, j) == \E k \in DOMAIN Ops[o].writes :
                  Ops[o].writes[k].k = "closeJudge" /\ Ops[o].writes[k].c = j

(* A judgement is closed (answered or expired) at most once in an epoch:   *)
(* no second answer, and never both answered and expired.                  *)
JudgementClosedOnce ==
  \A j \in Judgements, i, k \in DOMAIN events :
    (i # k /\ events[i].accepted /\ events[k].accepted
     /\ Closes(events[i].id, j) /\ Closes(events[k].id, j)) => events[i].epoch # events[k].epoch

(* A cursor never moves back, a clear included.                            *)
CursorMonotone ==
  \A i \in DOMAIN events :
    events[i].accepted =>
      \A x \in Cursors : events[i].after.cursors[x] >= events[i].before.cursors[x]

(* No cursor is past the log: at most the seq of the last event.           *)
CursorWithinLog == \A x \in Cursors : cursors[x] <= Len(events)

(* The events table holds exactly what was committed, in order: no event   *)
(* was updated or deleted. Structural here (only Execute writes events,    *)
(* and only by Append); StoreLogTampered adds the UPDATE the trigger       *)
(* refuses. TRUNCATE, which fires no row trigger, is refused by a          *)
(* statement trigger; the model has no action for it, so that is           *)
(* structural too.                                                         *)
LogAppendOnly == events = ledger

(* A policy version, once put, keeps its body for good: no op changes or   *)
(* removes it, a clear included.                                           *)
PolicyImmutable ==
  \A i \in DOMAIN events, v \in Versions :
    events[i].before.policies[v] # Absent => events[i].after.policies[v] = events[i].before.policies[v]

(* A caller that says it knows the outcome holds the stored receipt:       *)
(* unknown is never reported as unchanged or as a different answer.        *)
ReceiptMatches ==
  \A o \in OpIds :
    phase[o] = "done" => (o \in applied /\ receipt[o] = StoredEvent(o))

-----------------------------------------------------------------------------
(* Reachability: these are expected to be VIOLATED (reach/*.cfg). Each     *)
(* violation shows that the passing run above is not vacuous.              *)

AcceptedIds == {events[i].id : i \in {j \in DOMAIN events : events[j].accepted}}
RefusedIds  == {events[i].id : i \in {j \in DOMAIN events : ~events[j].accepted}}
\* refused although its epoch was right and its conditions held: a write rule fired
RuleRefused(o) ==
  \E i \in DOMAIN events :
    /\ events[i].id = o /\ ~events[i].accepted
    /\ Ops[o].epoch = events[i].epoch /\ Holds(events[i].before, Ops[o].expect)
\* refused in its own epoch because condition x failed
FencedBy(o, x) ==
  \E i \in DOMAIN events :
    /\ events[i].id = o /\ ~events[i].accepted
    /\ Ops[o].epoch = events[i].epoch /\ ~Cond(events[i].before, x)

NeverTaken      == "a1" \notin AcceptedIds
NeverRecovered  == \A o \in OpIds : ~(lost[o] > 0 /\ phase[o] = "done")
NeverStaleEpochRefused ==
  \A i \in DOMAIN events : ~(~events[i].accepted /\ Ops[events[i].id].epoch # events[i].epoch)
NeverNeedsReady == "s9" \notin AcceptedIds
NeverNewEpochOp == "k2" \notin AcceptedIds
\* round 22: the store takes two working consumers on one row (u1 by a1, u2 by b2 on r1): width is the roster's
NeverTwoWorking ==
  Cardinality({c \in Cards : cards[c].holder = "r1" /\ cards[c].state = "working"}) < 2
NeverProducerRefused  == "s3" \notin RefusedIds
NeverSentinelRefused  == "s4" \notin RefusedIds
\* g1 holds r1 and the hold survives the clear into epoch 2
NeverHeldCarried      == ~(epoch = 2 /\ rows["r1"].held)
\* a1 is refused because g1 held r1 first (RowHeld)
NeverHeldRefused      == ~FencedBy("a1", RowHeld("r1", FALSE))
\* s23 is refused because s21 stopped the sprint first (Running)
NeverStoppedRefused   == ~FencedBy("s23", Running)
\* e1 sets r1 down (fenced on RowGen(r1, 0))
NeverRowDown          == "e1" \notin AcceptedIds
\* e1 is refused on a stale RowGen after g1 wrote r1
NeverRowFenced        == ~FencedBy("e1", RowGen("r1", 0))
NeverAnswered         == judgements["j1"] # "answered"
\* a second fenced close (h1 or y1) is refused by the JudgementOpen fence
NeverJudgementFenced  ==
  \A o \in {"h1", "y1"} : ~FencedBy(o, JudgementOpen("j1"))
NeverCursorRefused    == ~RuleRefused("m2")
\* h2 (no fence) is refused by the write itself after h1 or y1 closed j1
NeverCloseRefused     == ~RuleRefused("h2")
\* m3 is refused: it would pass the log
NeverCursorPastRefused == ~RuleRefused("m3")
\* the clear keeps the cursor
NeverCursorCarried    == ~(epoch = 2 /\ cursors["c1"] > 0)
\* s13 adds a second policy version beside the first
NeverTwoPolicies      == policies[2] = Absent
\* s14 sets p2 red
NeverRed              == ~cards["p2"].red
\* s15 (a consumer) and s16 (a sentinel) are refused by the red write
NeverRedKindRefused   == ~(RuleRefused("s15") /\ RuleRefused("s16"))
\* s17 sets p2 red when it is red: refused as changing nothing
NeverSameRedRefused   == ~RuleRefused("s17")
\* s18 hooks r2 by y while x holds it: refused
NeverHookRefused      == ~RuleRefused("s18")
\* s19 unhooks r2 and s20 hooks it by y as coordinator
NeverRehooked         == ~(rows["r2"].sess = "y" /\ rows["r2"].role = "coordinator")
\* s21 stops the sprint, and a deal lands while it is stopped
NeverDealtStopped     == ~(stopped /\ cards["u1"].state = "working")
\* s22 stops it again: refused as changing nothing
NeverSameStopRefused  == ~RuleRefused("s22")
\* n1, a tick op on the fresh store, is refused: the sprint was never started
NeverFreshRefused     == ~FencedBy("n1", Running)

=============================================================================
